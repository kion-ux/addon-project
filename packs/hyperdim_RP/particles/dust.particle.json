{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "hd:dust",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/hd_atlas"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": "v.count ?? 12"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0
      },
      "minecraft:emitter_shape_disc": {
        "radius": "v.spread ?? 0.6",
        "plane_normal": [
          0,
          1,
          0
        ],
        "direction": "outwards"
      },
      "minecraft:particle_initial_speed": "(v.speed ?? 5.0) * (0.5 + v.particle_random_1 * 0.5)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0.3,
          0
        ],
        "linear_drag_coefficient": 3.5
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "(v.life ?? 0.8) * (0.6 + v.particle_random_2 * 0.6)"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(v.size ?? 1.0) * (0.35 + (v.particle_age / v.particle_lifetime) * 0.6)",
          "(v.size ?? 1.0) * (0.35 + (v.particle_age / v.particle_lifetime) * 0.6)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 512,
          "texture_height": 512,
          "uv": [
            128,
            128
          ],
          "uv_size": [
            64,
            64
          ]
        }
      },
      "minecraft:particle_initial_spin": {
        "rotation": "v.particle_random_3 * 360",
        "rotation_rate": 30
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "(v.cr ?? 0.62)",
          "(v.cg ?? 0.56)",
          "(v.cb ?? 0.48)",
          "0.7 * math.clamp((1.0 - (v.particle_age / v.particle_lifetime)) * 1.6, 0.0, 1.0)"
        ]
      }
    }
  }
}
