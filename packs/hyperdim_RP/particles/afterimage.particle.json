{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "hd:afterimage",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/hd_atlas"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": "v.count ?? 1"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          0,
          0,
          0
        ],
        "direction": [
          "v.vx ?? 0",
          "v.vy ?? 0",
          "v.vz ?? 0"
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "v.life ?? 0.4"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(v.size ?? 1.0) * 1.0",
          "(v.size ?? 1.0) * 2.0"
        ],
        "facing_camera_mode": "rotate_y",
        "uv": {
          "texture_width": 512,
          "texture_height": 512,
          "uv": [
            416,
            128
          ],
          "uv_size": [
            64,
            128
          ]
        }
      },
      "color": [
        "v.cr ?? 1.0",
        "v.cg ?? 1.0",
        "v.cb ?? 1.0",
        "0.85 * math.clamp(1.0 - (v.particle_age / v.particle_lifetime), 0.0, 1.0)"
      ]
    }
  }
}
