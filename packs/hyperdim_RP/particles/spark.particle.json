{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "hd:spark",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/hd_atlas"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": "v.count ?? 8"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0
      },
      "minecraft:emitter_shape_sphere": {
        "radius": "0.05",
        "direction": "outwards",
        "surface_only": false
      },
      "minecraft:particle_initial_speed": "(v.speed ?? 7.0) * (0.5 + v.particle_random_1)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          -14,
          0
        ],
        "linear_drag_coefficient": 3.2
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "(v.life ?? 0.35) * (0.6 + v.particle_random_2 * 0.6)"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(v.size ?? 1.0) * 0.07",
          "(v.size ?? 1.0) * 0.42 * (1.0 - (v.particle_age / v.particle_lifetime))"
        ],
        "facing_camera_mode": "lookat_direction",
        "uv": {
          "texture_width": 512,
          "texture_height": 512,
          "uv": [
            64,
            0
          ],
          "uv_size": [
            64,
            64
          ]
        }
      },
      "color": [
        "math.lerp(v.cr ?? 1.0, 1.0, math.clamp(1.0 - (v.particle_age / v.particle_lifetime) * 5, 0.0, 1.0))",
        "math.lerp(v.cg ?? 1.0, 1.0, math.clamp(1.0 - (v.particle_age / v.particle_lifetime) * 5, 0.0, 1.0))",
        "math.lerp(v.cb ?? 1.0, 1.0, math.clamp(1.0 - (v.particle_age / v.particle_lifetime) * 5, 0.0, 1.0))",
        "math.clamp((1.0 - (v.particle_age / v.particle_lifetime)) * 1.6, 0.0, 1.0)"
      ]
    }
  }
}
