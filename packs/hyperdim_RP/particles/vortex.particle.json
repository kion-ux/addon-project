{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "hd:vortex",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/hd_atlas"
      }
    },
    "components": {
      "minecraft:emitter_rate_steady": {
        "spawn_rate": "v.rate ?? 60",
        "max_particles": 200
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": "v.life ?? 1.0"
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          0,
          0,
          0
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.8"
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "math.cos(v.particle_age * 720.0 + v.particle_random_1 * 360.0) * (v.size ?? 1.0) * (0.3 + (v.particle_age / v.particle_lifetime))",
          "(v.particle_age / v.particle_lifetime) * (v.height ?? 4.0)",
          "math.sin(v.particle_age * 720.0 + v.particle_random_1 * 360.0) * (v.size ?? 1.0) * (0.3 + (v.particle_age / v.particle_lifetime))"
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(v.size ?? 1.0) * 0.5",
          "(v.size ?? 1.0) * 0.25"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 512,
          "texture_height": 512,
          "uv": [
            192,
            128
          ],
          "uv_size": [
            64,
            64
          ]
        }
      },
      "minecraft:particle_initial_spin": {
        "rotation": "v.particle_random_2 * 360",
        "rotation_rate": 300
      },
      "color": [
        "math.lerp(v.cr ?? 1.0, 1.0, math.clamp(1.0 - (v.particle_age / v.particle_lifetime) * 2, 0.0, 1.0))",
        "math.lerp(v.cg ?? 1.0, 1.0, math.clamp(1.0 - (v.particle_age / v.particle_lifetime) * 2, 0.0, 1.0))",
        "math.lerp(v.cb ?? 1.0, 1.0, math.clamp(1.0 - (v.particle_age / v.particle_lifetime) * 2, 0.0, 1.0))",
        "math.clamp(math.min((v.particle_age / v.particle_lifetime) * 6.0, (1.0 - (v.particle_age / v.particle_lifetime)) * 2.5), 0.0, 1.0)"
      ]
    }
  }
}
