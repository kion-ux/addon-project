{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "hd:orbit",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/hd_atlas"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": "v.count ?? 10"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          0,
          0,
          0
        ],
        "direction": [
          0,
          0,
          0
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "v.life ?? 0.8"
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "math.cos(v.particle_age * 540.0 + v.particle_random_1 * 360.0) * (v.spread ?? 1.5) * (1.0 - (v.particle_age / v.particle_lifetime))",
          "(v.particle_random_2 - 0.5) * (v.spread ?? 1.5) * (1.0 - (v.particle_age / v.particle_lifetime))",
          "math.sin(v.particle_age * 540.0 + v.particle_random_1 * 360.0) * (v.spread ?? 1.5) * (1.0 - (v.particle_age / v.particle_lifetime))"
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(v.size ?? 1.0) * 0.16",
          "(v.size ?? 1.0) * 0.16"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 512,
          "texture_height": 512,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            64,
            64
          ]
        }
      },
      "color": [
        "math.lerp(v.cr ?? 1.0, 1.0, math.clamp(1.0 - (v.particle_age / v.particle_lifetime) * 1, 0.0, 1.0))",
        "math.lerp(v.cg ?? 1.0, 1.0, math.clamp(1.0 - (v.particle_age / v.particle_lifetime) * 1, 0.0, 1.0))",
        "math.lerp(v.cb ?? 1.0, 1.0, math.clamp(1.0 - (v.particle_age / v.particle_lifetime) * 1, 0.0, 1.0))",
        "math.clamp(math.min((v.particle_age / v.particle_lifetime) * 6.0, (1.0 - (v.particle_age / v.particle_lifetime)) * 2.5), 0.0, 1.0)"
      ]
    }
  }
}
