{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "hd:wind",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/hd_atlas"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": "v.count ?? 4"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0
      },
      "minecraft:emitter_shape_sphere": {
        "radius": "v.spread ?? 0.8",
        "direction": [
          "v.vx ?? 0",
          "v.vy ?? 0",
          "v.vz ?? 1"
        ],
        "surface_only": false
      },
      "minecraft:particle_initial_speed": "(v.speed ?? 6.0) * (0.7 + v.particle_random_1 * 0.6)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0,
          0
        ],
        "linear_drag_coefficient": 2.4
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "(v.life ?? 0.4) * (0.6 + v.particle_random_2 * 0.6)"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(v.size ?? 1.0) * 0.9",
          "(v.size ?? 1.0) * 0.45"
        ],
        "facing_camera_mode": "lookat_direction",
        "uv": {
          "texture_width": 512,
          "texture_height": 512,
          "uv": [
            192,
            128
          ],
          "uv_size": [
            64,
            64
          ]
        }
      },
      "color": [
        "math.lerp(v.cr ?? 1.0, 1.0, math.clamp(1.0 - (v.particle_age / v.particle_lifetime) * 2, 0.0, 1.0))",
        "math.lerp(v.cg ?? 1.0, 1.0, math.clamp(1.0 - (v.particle_age / v.particle_lifetime) * 2, 0.0, 1.0))",
        "math.lerp(v.cb ?? 1.0, 1.0, math.clamp(1.0 - (v.particle_age / v.particle_lifetime) * 2, 0.0, 1.0))",
        "math.clamp((1.0 - (v.particle_age / v.particle_lifetime)) * 1.6, 0.0, 1.0)"
      ]
    }
  }
}
