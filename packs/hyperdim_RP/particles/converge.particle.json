{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "hd:converge",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/hd_atlas"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": "v.count ?? 16"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0
      },
      "minecraft:emitter_shape_sphere": {
        "radius": "v.spread ?? 2.0",
        "direction": "inwards",
        "surface_only": true
      },
      "minecraft:particle_initial_speed": "(v.spread ?? 2.0) / (v.life ?? 0.5) * 1.05",
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "v.life ?? 0.5"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(v.size ?? 1.0) * 0.05",
          "(v.size ?? 1.0) * 0.5"
        ],
        "facing_camera_mode": "lookat_direction",
        "uv": {
          "texture_width": 512,
          "texture_height": 512,
          "uv": [
            256,
            128
          ],
          "uv_size": [
            128,
            32
          ]
        }
      },
      "color": [
        "math.lerp(v.cr ?? 1.0, 1.0, math.clamp(1.0 - (v.particle_age / v.particle_lifetime) * 1, 0.0, 1.0))",
        "math.lerp(v.cg ?? 1.0, 1.0, math.clamp(1.0 - (v.particle_age / v.particle_lifetime) * 1, 0.0, 1.0))",
        "math.lerp(v.cb ?? 1.0, 1.0, math.clamp(1.0 - (v.particle_age / v.particle_lifetime) * 1, 0.0, 1.0))",
        "math.clamp(math.min((v.particle_age / v.particle_lifetime) * 6.0, (1.0 - (v.particle_age / v.particle_lifetime)) * 2.5), 0.0, 1.0)"
      ]
    }
  }
}
