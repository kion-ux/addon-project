{
  "format_version": "1.8.0",
  "minecraft:spawn_rules": {
    "description": {
      "identifier": "aot:titan_small",
      "population_control": "monster"
    },
    "conditions": [
      {
        "minecraft:spawns_on_surface": {},
        "minecraft:brightness_filter": {
          "min": 10,
          "max": 15,
          "adjust_for_weather": false
        },
        "minecraft:difficulty_filter": {
          "min": "easy",
          "max": "hard"
        },
        "minecraft:weight": {
          "default": 5
        },
        "minecraft:herd": {
          "min_size": 1,
          "max_size": 1
        },
        "minecraft:density_limit": {
          "surface": 1
        },
        "minecraft:biome_filter": {
          "any_of": [
            {
              "test": "has_biome_tag",
              "operator": "==",
              "value": "plains"
            },
            {
              "test": "has_biome_tag",
              "operator": "==",
              "value": "forest"
            },
            {
              "test": "has_biome_tag",
              "operator": "==",
              "value": "savanna"
            },
            {
              "test": "has_biome_tag",
              "operator": "==",
              "value": "taiga"
            },
            {
              "test": "has_biome_tag",
              "operator": "==",
              "value": "meadow"
            },
            {
              "test": "has_biome_tag",
              "operator": "==",
              "value": "birch"
            }
          ]
        }
      }
    ]
  }
}
