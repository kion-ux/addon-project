{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "astro:cloud",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/astro_atlas"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.e_dx = (v.vx ?? 0.0); v.e_dy = (v.vy ?? 0.0); v.e_dz = (v.vz ?? 0.0); v.e_dl = math.sqrt(v.e_dx * v.e_dx + v.e_dy * v.e_dy + v.e_dz * v.e_dz); v.e_has = (v.e_dl > 0.0001) ? 1.0 : 0.0; v.e_tx = (v.e_has > 0.5) ? v.e_dx : 0.15; v.e_ty = (v.e_has > 0.5) ? v.e_dy : 0.06; v.e_tz = (v.e_has > 0.5) ? v.e_dz : 0.0; v.e_tl = (v.e_has > 0.5) ? v.e_dl : 0.1616; v.e_nx = v.e_tx / math.max(v.e_tl, 0.0001); v.e_ny = v.e_ty / math.max(v.e_tl, 0.0001); v.e_nz = v.e_tz / math.max(v.e_tl, 0.0001); v.e_h = math.sqrt(v.e_nx * v.e_nx + v.e_nz * v.e_nz); v.e_ax = (v.e_h > 0.2) ? ((0.0 - v.e_nz) / v.e_h) : 1.0; v.e_ay = 0.0; v.e_az = (v.e_h > 0.2) ? (v.e_nx / v.e_h) : 0.0; v.e_bx = v.e_ny * v.e_az - v.e_nz * v.e_ay; v.e_by = v.e_nz * v.e_ax - v.e_nx * v.e_az; v.e_bz = v.e_nx * v.e_ay - v.e_ny * v.e_ax;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": "(v.count ?? 5.0)"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          0,
          0,
          0
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "(v.life ?? 4.0) * math.random(0.9, 1.1)"
      },
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "(v.particle_random_1 * 2.0 - 1.0) * (v.spread ?? 1.2) * (1.0 + 0.25 * (v.particle_age / v.particle_lifetime)) + v.e_tx * v.particle_age",
          "(v.particle_random_2 * 2.0 - 1.0) * (v.spread ?? 1.2) * 0.45 * (1.0 + 0.25 * (v.particle_age / v.particle_lifetime)) + v.e_ty * v.particle_age",
          "(v.particle_random_3 * 2.0 - 1.0) * (v.spread ?? 1.2) * (1.0 + 0.25 * (v.particle_age / v.particle_lifetime)) + v.e_tz * v.particle_age"
        ],
        "rotation": "v.particle_random_4 * 360.0 + v.particle_age * (v.spin ?? 10.0)"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(v.size ?? 1.0) * 1.6 * (0.8 + 0.5 * (v.particle_age / v.particle_lifetime)) * (0.7 + 0.6 * v.particle_random_4)",
          "(v.size ?? 1.0) * 1.6 * (0.8 + 0.5 * (v.particle_age / v.particle_lifetime)) * (0.7 + 0.6 * v.particle_random_4)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 1024,
          "texture_height": 1024,
          "uv": [
            517,
            453
          ],
          "uv_size": [
            128,
            128
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "(v.cr ?? 0.92)",
          "(v.cg ?? 0.86)",
          "(v.cb ?? 0.45)",
          "0.85 * math.clamp(math.min(v.particle_age * 2.5, (v.particle_lifetime - v.particle_age) * 1.25), 0.0, 1.0)"
        ]
      }
    }
  }
}
