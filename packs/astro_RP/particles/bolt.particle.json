{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "astro:bolt",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/astro_atlas"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.e_dx = (v.vx ?? 0.0); v.e_dy = (v.vy ?? 0.0); v.e_dz = (v.vz ?? 0.0); v.e_dl = math.sqrt(v.e_dx * v.e_dx + v.e_dy * v.e_dy + v.e_dz * v.e_dz); v.e_has = (v.e_dl > 0.0001) ? 1.0 : 0.0; v.e_nx = (v.e_has > 0.5) ? (v.e_dx / math.max(v.e_dl, 0.0001)) : 0.0; v.e_ny = (v.e_has > 0.5) ? (v.e_dy / math.max(v.e_dl, 0.0001)) : 1.0; v.e_nz = (v.e_has > 0.5) ? (v.e_dz / math.max(v.e_dl, 0.0001)) : 0.0; v.e_len = (v.len ?? 6.0);"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          0,
          0,
          0
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "(v.life ?? 0.22)"
      },
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "v.e_nx * v.e_len * 0.5",
          "v.e_ny * v.e_len * 0.5",
          "v.e_nz * v.e_len * 0.5"
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "v.e_len",
          "(v.size ?? 1.0) * 0.9"
        ],
        "facing_camera_mode": "lookat_direction",
        "direction": {
          "mode": "custom",
          "custom_direction": [
            "v.e_nx",
            "v.e_ny",
            "v.e_nz"
          ]
        },
        "uv": {
          "texture_width": 1024,
          "texture_height": 1024,
          "uv": [
            521.0,
            "583.0 + math.clamp(math.floor(math.mod((v.var ?? (v.particle_age * 30.0 + v.emitter_random_1 * 3.0)), 3.0)), 0.0, 2.0) * 36.0"
          ],
          "uv_size": [
            256,
            36
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "math.lerp((v.cr ?? 0.6), 1.0, math.clamp(1.0 - (v.particle_age / v.particle_lifetime) * 1.2, 0.0, 1.0)) * (math.mod(math.floor(v.particle_age * 40.0), 2.0) > 0.5 ? 0.5 : 1.0) * math.clamp((1.0 - (v.particle_age / v.particle_lifetime)) * 1.3, 0.0, 1.0)",
          "math.lerp((v.cg ?? 0.92), 1.0, math.clamp(1.0 - (v.particle_age / v.particle_lifetime) * 1.2, 0.0, 1.0)) * (math.mod(math.floor(v.particle_age * 40.0), 2.0) > 0.5 ? 0.5 : 1.0) * math.clamp((1.0 - (v.particle_age / v.particle_lifetime)) * 1.3, 0.0, 1.0)",
          "math.lerp((v.cb ?? 1.0), 1.0, math.clamp(1.0 - (v.particle_age / v.particle_lifetime) * 1.2, 0.0, 1.0)) * (math.mod(math.floor(v.particle_age * 40.0), 2.0) > 0.5 ? 0.5 : 1.0) * math.clamp((1.0 - (v.particle_age / v.particle_lifetime)) * 1.3, 0.0, 1.0)",
          "(math.mod(math.floor(v.particle_age * 40.0), 2.0) > 0.5 ? 0.5 : 1.0) * math.clamp((1.0 - (v.particle_age / v.particle_lifetime)) * 1.3, 0.0, 1.0)"
        ]
      }
    }
  }
