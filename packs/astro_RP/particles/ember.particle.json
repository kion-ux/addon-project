{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "astro:ember",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/astro_atlas"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": "(v.count ?? 8.0)"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0
      },
      "minecraft:emitter_shape_sphere": {
        "offset": [
          0,
          0,
          0
        ],
        "radius": "(v.spread ?? 0.6)",
        "surface_only": false,
        "direction": "outwards"
      },
      "minecraft:particle_initial_speed": "(v.speed ?? 1.0) * math.random(0.0, 1.0)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          1.8,
          0
        ],
        "linear_drag_coefficient": 0.8
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "(v.life ?? 1.2) * math.random(0.5, 1.3)"
