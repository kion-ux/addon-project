      "minecraft:particle_appearance_billboard": {
        "size": [
          "(v.size ?? 1.0) * 0.07 * (0.7 + 0.3 * math.sin(v.particle_age * 1400.0 + v.particle_random_1 * 360.0))",
          "(v.size ?? 1.0) * 0.07 * (0.7 + 0.3 * math.sin(v.particle_age * 1400.0 + v.particle_random_1 * 360.0))"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 1024,
          "texture_height": 1024,
          "uv": [
            977,
            877
          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "math.lerp((v.cr ?? 1.0), 1.0, math.clamp(1.0 - (v.particle_age / v.particle_lifetime) * 1.5, 0.0, 1.0)) * math.clamp(math.min((v.particle_age / v.particle_lifetime) * 6.0, (1.0 - (v.particle_age / v.particle_lifetime)) * 2.0), 0.0, 1.0)",
          "math.lerp((v.cg ?? 0.55), 1.0, math.clamp(1.0 - (v.particle_age / v.particle_lifetime) * 1.5, 0.0, 1.0)) * math.clamp(math.min((v.particle_age / v.particle_lifetime) * 6.0, (1.0 - (v.particle_age / v.particle_lifetime)) * 2.0), 0.0, 1.0)",
          "math.lerp((v.cb ?? 0.16), 1.0, math.clamp(1.0 - (v.particle_age / v.particle_lifetime) * 1.5, 0.0, 1.0)) * math.clamp(math.min((v.particle_age / v.particle_lifetime) * 6.0, (1.0 - (v.particle_age / v.particle_lifetime)) * 2.0), 0.0, 1.0)",
          "math.clamp(math.min((v.particle_age / v.particle_lifetime) * 6.0, (1.0 - (v.particle_age / v.particle_lifetime)) * 2.0), 0.0, 1.0)"
        ]
