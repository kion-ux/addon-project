{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "astro:vortex",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/astro_atlas"
      }
    },
    "components": {
      "minecraft:emitter_rate_steady": {
        "spawn_rate": "(v.rate ?? 70.0)",
        "max_particles": 160
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": "(v.life ?? 1.0)"
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          0,
          0,
          0
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.9"
      },
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "math.cos((v.particle_age * (v.spin ?? 540.0) + v.particle_random_1 * 360.0)) * ((v.spread ?? 1.2) * (0.35 + 0.65 * (v.particle_age / v.particle_lifetime)))",
          "(v.particle_age / v.particle_lifetime) * (v.height ?? 3.5)",
          "math.sin((v.particle_age * (v.spin ?? 540.0) + v.particle_random_1 * 360.0)) * ((v.spread ?? 1.2) * (0.35 + 0.65 * (v.particle_age / v.particle_lifetime)))"
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(v.size ?? 1.0) * 0.6 * (1.0 - (v.particle_age / v.particle_lifetime) * 0.4)",
          "(v.size ?? 1.0) * 0.14"
        ],
        "facing_camera_mode": "lookat_direction",
        "direction": {
          "mode": "custom",
          "custom_direction": [
            "0.0 - math.sin((v.particle_age * (v.spin ?? 540.0) + v.particle_random_1 * 360.0))",
            "0.35",
            "math.cos((v.particle_age * (v.spin ?? 540.0) + v.particle_random_1 * 360.0))"
          ]
        },
        "uv": {
          "texture_width": 1024,
          "texture_height": 1024,
          "uv": [
            877,
            747
          ],
          "uv_size": [
            128,
            64
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "math.lerp((v.cr ?? 0.47), 1.0, math.clamp(1.0 - (v.particle_age / v.particle_lifetime) * 2.0, 0.0, 1.0)) * math.clamp(math.min((v.particle_age / v.particle_lifetime) * 5.0, (1.0 - (v.particle_age / v.particle_lifetime)) * 3.0), 0.0, 1.0)",
          "math.lerp((v.cg ?? 0.94), 1.0, math.clamp(1.0 - (v.particle_age / v.particle_lifetime) * 2.0, 0.0, 1.0)) * math.clamp(math.min((v.particle_age / v.particle_lifetime) * 5.0, (1.0 - (v.particle_age / v.particle_lifetime)) * 3.0), 0.0, 1.0)",
          "math.lerp((v.cb ?? 1.0), 1.0, math.clamp(1.0 - (v.particle_age / v.particle_lifetime) * 2.0, 0.0, 1.0)) * math.clamp(math.min((v.particle_age / v.particle_lifetime) * 5.0, (1.0 - (v.particle_age / v.particle_lifetime)) * 3.0), 0.0, 1.0)",
          "math.clamp(math.min((v.particle_age / v.particle_lifetime) * 5.0, (1.0 - (v.particle_age / v.particle_lifetime)) * 3.0), 0.0, 1.0)"
        ]
      }
    }
  }
}
