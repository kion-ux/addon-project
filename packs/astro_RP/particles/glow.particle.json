{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "astro:glow",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/astro_atlas"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.e_dx = (v.vx ?? 0.0); v.e_dy = (v.vy ?? 0.0); v.e_dz = (v.vz ?? 0.0); v.e_dl = math.sqrt(v.e_dx * v.e_dx + v.e_dy * v.e_dy + v.e_dz * v.e_dz); v.e_has = (v.e_dl > 0.0001) ? 1.0 : 0.0; v.e_nx = (v.e_has > 0.5) ? (v.e_dx / math.max(v.e_dl, 0.0001)) : 0.0; v.e_ny = (v.e_has > 0.5) ? (v.e_dy / math.max(v.e_dl, 0.0001)) : 1.0; v.e_nz = (v.e_has > 0.5) ? (v.e_dz / math.max(v.e_dl, 0.0001)) : 0.0;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": "(v.count ?? 1.0)"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          "math.random(-1.0, 1.0) * (v.spread ?? 0.0)",
          "math.random(-1.0, 1.0) * (v.spread ?? 0.0)",
          "math.random(-1.0, 1.0) * (v.spread ?? 0.0)"
        ],
        "direction": [
          "v.e_nx",
          "v.e_ny",
          "v.e_nz"
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "(v.life ?? 0.4) * math.random(0.85, 1.15)"
      },
      "minecraft:particle_initial_speed": "(v.speed ?? 0.0)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0,
          0
        ],
        "linear_drag_coefficient": 2.5
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(v.size ?? 1.0) * 0.5 * (1.0 - (v.particle_age / v.particle_lifetime) * 0.5)",
          "(v.size ?? 1.0) * 0.5 * (1.0 - (v.particle_age / v.particle_lifetime) * 0.5)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 1024,
          "texture_height": 1024,
          "uv": [
            325,
            811
          ],
          "uv_size": [
            64,
            64
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "math.lerp((v.cr ?? 0.47), 1.0, math.clamp(1.0 - (v.particle_age / v.particle_lifetime) * 4.0, 0.0, 1.0)) * math.clamp((1.0 - (v.particle_age / v.particle_lifetime)) * 1.6, 0.0, 1.0)",
          "math.lerp((v.cg ?? 0.94), 1.0, math.clamp(1.0 - (v.particle_age / v.particle_lifetime) * 4.0, 0.0, 1.0)) * math.clamp((1.0 - (v.particle_age / v.particle_lifetime)) * 1.6, 0.0, 1.0)",
          "math.lerp((v.cb ?? 1.0), 1.0, math.clamp(1.0 - (v.particle_age / v.particle_lifetime) * 4.0, 0.0, 1.0)) * math.clamp((1.0 - (v.particle_age / v.particle_lifetime)) * 1.6, 0.0, 1.0)",
          "math.clamp((1.0 - (v.particle_age / v.particle_lifetime)) * 1.6, 0.0, 1.0)"
        ]
      }
    }
  }
