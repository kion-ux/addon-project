          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "(v.cr ?? 0.42)",
          "(v.cg ?? 0.36)",
          "(v.cb ?? 0.32)",
          "math.clamp((1.0 - (v.particle_age / v.particle_lifetime)) * 4.0, 0.0, 1.0)"
