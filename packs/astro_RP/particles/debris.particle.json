          "math.random(0.3, 1.6)",
          "math.random(-1.0, 1.0)"
        ]
      },
      "minecraft:particle_initial_speed": "(v.speed ?? 7.0) * math.random(0.5, 1.0)",
      "minecraft:particle_motion_dynamic": {
