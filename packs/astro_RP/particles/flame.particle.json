{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "astro:flame",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/astro_atlas"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": "(v.count ?? 6.0)"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0
      },
      "minecraft:emitter_shape_sphere": {
        "offset": [
          0,
          0,
          0
        ],
        "radius": "(v.spread ?? 0.4)",
        "surface_only": false,
        "direction": "outwards"
      },
      "minecraft:particle_initial_speed": "(v.speed ?? 1.5) * math.random(0.0, 1.0)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          3.0,
          0
        ],
        "linear_drag_coefficient": 2.0
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "(v.life ?? 0.6) * math.random(0.6, 1.2)"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(v.size ?? 1.0) * 0.42 * (1.0 - (v.particle_age / v.particle_lifetime) * 0.3)",
          "(v.size ?? 1.0) * 0.56 * (1.0 - (v.particle_age / v.particle_lifetime) * 0.2)"
        ],
        "facing_camera_mode": "rotate_y",
        "uv": {
          "texture_width": 1024,
          "texture_height": 1024,
          "flipbook": {
            "base_UV": [
              1,
              745
            ],
            "size_UV": [
              64,
              64
            ],
            "step_UV": [
              64,
              0
            ],
            "frames_per_second": 12,
            "max_frame": 8,
            "stretch_to_lifetime": true
          }
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "math.lerp((v.cr ?? 1.0), 1.0, math.clamp(1.0 - (v.particle_age / v.particle_lifetime) * 2.5, 0.0, 1.0)) * math.clamp(math.min((v.particle_age / v.particle_lifetime) * 10.0, (1.0 - (v.particle_age / v.particle_lifetime)) * 1.5), 0.0, 1.0)",
          "math.lerp((v.cg ?? 0.55), 1.0, math.clamp(1.0 - (v.particle_age / v.particle_lifetime) * 2.5, 0.0, 1.0)) * math.clamp(math.min((v.particle_age / v.particle_lifetime) * 10.0, (1.0 - (v.particle_age / v.particle_lifetime)) * 1.5), 0.0, 1.0)",
          "math.lerp((v.cb ?? 0.16), 1.0, math.clamp(1.0 - (v.particle_age / v.particle_lifetime) * 2.5, 0.0, 1.0)) * math.clamp(math.min((v.particle_age / v.particle_lifetime) * 10.0, (1.0 - (v.particle_age / v.particle_lifetime)) * 1.5), 0.0, 1.0)",
          "math.clamp(math.min((v.particle_age / v.particle_lifetime) * 10.0, (1.0 - (v.particle_age / v.particle_lifetime)) * 1.5), 0.0, 1.0)"
        ]
      }
    }
  }
}
