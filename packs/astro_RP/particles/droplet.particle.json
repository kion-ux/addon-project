{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "astro:droplet",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/astro_atlas"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": "(v.count ?? 10.0)"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0
      },
      "minecraft:emitter_shape_sphere": {
        "offset": [
          0,
          0,
          0
        ],
        "radius": "(v.spread ?? 0.2)",
        "surface_only": false,
        "direction": "outwards"
      },
      "minecraft:particle_initial_speed": "(v.speed ?? 4.0) * math.random(0.5, 1.2)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          "(v.grav ?? -14.0)",
          0
        ],
        "linear_drag_coefficient": 0.5
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "(v.life ?? 0.7) * math.random(0.7, 1.2)"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(v.size ?? 1.0) * 0.2",
          "(v.size ?? 1.0) * 0.13"
        ],
        "facing_camera_mode": "lookat_direction",
        "direction": {
          "mode": "derive_from_velocity",
          "min_speed_threshold": 0.05
        },
        "uv": {
          "texture_width": 1024,
          "texture_height": 1024,
          "uv": [
            971,
            847
          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "(v.cr ?? 0.85)",
          "(v.cg ?? 0.9)",
          "(v.cb ?? 0.95)",
          "math.clamp((1.0 - (v.particle_age / v.particle_lifetime)) * 3.0, 0.0, 1.0)"
        ]
      }
    }
  }
}
