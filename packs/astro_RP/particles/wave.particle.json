{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "astro:wave",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/astro_atlas"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.e_dx = (v.vx ?? 0.0); v.e_dy = (v.vy ?? 0.0); v.e_dz = (v.vz ?? 0.0); v.e_dl = math.sqrt(v.e_dx * v.e_dx + v.e_dy * v.e_dy + v.e_dz * v.e_dz); v.e_has = (v.e_dl > 0.0001) ? 1.0 : 0.0; v.e_nx = (v.e_has > 0.5) ? (v.e_dx / math.max(v.e_dl, 0.0001)) : 0.0; v.e_ny = (v.e_has > 0.5) ? (v.e_dy / math.max(v.e_dl, 0.0001)) : 0.0; v.e_nz = (v.e_has > 0.5) ? (v.e_dz / math.max(v.e_dl, 0.0001)) : 1.0;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          0,
          "(v.size ?? 1.0) * 0.6",
          0
        ],
        "direction": [
          "v.e_nx",
          "v.e_ny",
          "v.e_nz"
        ]
      },
      "minecraft:particle_initial_speed": "(v.speed ?? 8.0)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0,
          0
        ],
        "linear_drag_coefficient": 0.8
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "(v.life ?? 0.9)"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(v.size ?? 1.0) * 3.2 * (0.75 + 0.45 * (v.particle_age / v.particle_lifetime))",
          "(v.size ?? 1.0) * 1.4 * (0.4 + 0.6 * math.sin(math.clamp((v.particle_age / v.particle_lifetime) * 1.6, 0.0, 1.0) * 180.0))"
        ],
        "facing_camera_mode": "direction_z",
        "direction": {
          "mode": "custom",
          "custom_direction": [
            "v.e_nx",
            "v.e_ny",
            "v.e_nz"
          ]
        },
        "uv": {
          "texture_width": 1024,
          "texture_height": 1024,
          "uv": [
            779,
            583
          ],
          "uv_size": [
            192,
            96
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "(v.cr ?? 0.58)",
          "(v.cg ?? 0.87)",
          "(v.cb ?? 1.0)",
          "math.clamp(math.min((v.particle_age / v.particle_lifetime) * 12.0, (1.0 - (v.particle_age / v.particle_lifetime)) * 2.5), 0.0, 1.0)"
        ]
      }
    }
  }
}
