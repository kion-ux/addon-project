          "(v.cr ?? 0.47) * 0.8 * math.clamp(1.0 - (v.particle_age / v.particle_lifetime), 0.0, 1.0)",
          "(v.cg ?? 0.94) * 0.8 * math.clamp(1.0 - (v.particle_age / v.particle_lifetime), 0.0, 1.0)",
          "(v.cb ?? 1.0) * 0.8 * math.clamp(1.0 - (v.particle_age / v.particle_lifetime), 0.0, 1.0)",
