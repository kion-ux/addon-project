{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "astro:afterimage",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/astro_atlas"
      }
    },
    "components": {
