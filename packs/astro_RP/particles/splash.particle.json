{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "astro:splash",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/astro_atlas"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": "(v.count ?? 1.0)"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          0,
          0,
          0
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "(v.life ?? 0.45)"
      },
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "(v.particle_random_1 * 2.0 - 1.0) * (v.spread ?? 0.0)",
          "((v.size ?? 1.0) * 1.0 * (0.4 + 0.8 * math.sqrt((v.particle_age / v.particle_lifetime)))) * 0.5",
          "(v.particle_random_2 * 2.0 - 1.0) * (v.spread ?? 0.0)"
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(v.size ?? 1.0) * 1.2 * (0.5 + 0.7 * math.sqrt((v.particle_age / v.particle_lifetime)))",
          "((v.size ?? 1.0) * 1.0 * (0.4 + 0.8 * math.sqrt((v.particle_age / v.particle_lifetime))))"
        ],
        "facing_camera_mode": "rotate_y",
        "uv": {
          "texture_width": 1024,
          "texture_height": 1024,
          "uv": [
            521,
            725
          ],
          "uv_size": [
            96,
            96
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "(v.cr ?? 0.58)",
          "(v.cg ?? 0.87)",
          "(v.cb ?? 1.0)",
          "math.clamp((1.0 - (v.particle_age / v.particle_lifetime)) * 1.8, 0.0, 1.0)"
        ]
      }
    }
  }
}
