      "minecraft:particle_appearance_billboard": {
        "size": [
          "(v.size ?? 1.0) * 0.32 * (0.7 + 0.6 * v.particle_random_1)",
          "(v.size ?? 1.0) * 0.32 * (0.7 + 0.6 * v.particle_random_1)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 1024,
          "texture_height": 1024,
          "uv": [
            329,
            877
          ],
          "uv_size": [
            64,
            64
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "(v.cr ?? 0.78)",
          "(v.cg ?? 0.95)",
          "(v.cb ?? 1.0)",
          "math.clamp(math.min((v.particle_age / v.particle_lifetime) * 12.0, (1.0 - (v.particle_age / v.particle_lifetime)) * 2.0), 0.0, 1.0)"
        ]
      }
    }
  }
