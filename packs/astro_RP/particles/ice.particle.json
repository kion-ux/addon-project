        "direction": "outwards"
      },
      "minecraft:particle_initial_speed": "(v.speed ?? 4.0) * math.random(0.3, 1.0)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          "(v.grav ?? -9.0)",
          0
        ],
        "linear_drag_coefficient": 1.2
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0.0, 360.0)",
