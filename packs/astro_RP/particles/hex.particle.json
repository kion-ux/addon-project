{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "astro:hex",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/astro_atlas"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": "(v.count ?? 1.0)"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0
      },
      "minecraft:emitter_shape_sphere": {
        "offset": [
          0,
          0,
          0
        ],
        "radius": "(v.spread ?? 0.0)",
        "surface_only": true,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "(v.life ?? 0.6) * math.random(0.85, 1.15)"
      },
      "minecraft:particle_initial_spin": {
        "rotation": "(v.rot ?? 0.0)",
        "rotation_rate": 0
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(v.size ?? 1.0) * 0.6 * math.clamp(v.particle_age * 8.0, 0.0, 1.0)",
          "(v.size ?? 1.0) * 0.6 * math.clamp(v.particle_age * 8.0, 0.0, 1.0)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 1024,
          "texture_height": 1024,
          "uv": [
            263,
            877
          ],
          "uv_size": [
            64,
            64
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "(v.cr ?? 0.47) * math.clamp(math.min((v.particle_age / v.particle_lifetime) * 8.0, (1.0 - (v.particle_age / v.particle_lifetime)) * 3.0), 0.0, 1.0) * (v.particle_age < 0.12 ? (0.35 + 0.65 * math.mod(math.floor(v.particle_age * 50.0), 2.0)) : 1.0)",
          "(v.cg ?? 0.94) * math.clamp(math.min((v.particle_age / v.particle_lifetime) * 8.0, (1.0 - (v.particle_age / v.particle_lifetime)) * 3.0), 0.0, 1.0) * (v.particle_age < 0.12 ? (0.35 + 0.65 * math.mod(math.floor(v.particle_age * 50.0), 2.0)) : 1.0)",
          "(v.cb ?? 1.0) * math.clamp(math.min((v.particle_age / v.particle_lifetime) * 8.0, (1.0 - (v.particle_age / v.particle_lifetime)) * 3.0), 0.0, 1.0) * (v.particle_age < 0.12 ? (0.35 + 0.65 * math.mod(math.floor(v.particle_age * 50.0), 2.0)) : 1.0)",
          "math.clamp(math.min((v.particle_age / v.particle_lifetime) * 8.0, (1.0 - (v.particle_age / v.particle_lifetime)) * 3.0), 0.0, 1.0) * (v.particle_age < 0.12 ? (0.35 + 0.65 * math.mod(math.floor(v.particle_age * 50.0), 2.0)) : 1.0)"
        ]
      }
    }
  }
}
