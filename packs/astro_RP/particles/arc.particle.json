{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "astro:arc",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/astro_atlas"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": "(v.count ?? 3.0)"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          "math.random(-1.0, 1.0) * (v.spread ?? 0.4)",
          "math.random(-1.0, 1.0) * (v.spread ?? 0.4)",
          "math.random(-1.0, 1.0) * (v.spread ?? 0.4)"
        ]
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0.0, 360.0)",
        "rotation_rate": 0
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "(v.life ?? 0.2) * math.random(0.7, 1.3)"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(v.size ?? 1.0) * 0.6",
          "(v.size ?? 1.0) * 0.6"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 1024,
          "texture_height": 1024,
          "uv": [
            "521.0 + math.clamp(math.floor(math.mod(v.particle_age * 24.0 + v.particle_random_1 * 4.0, 4.0)), 0.0, 3.0) * 64.0",
            693.0
          ],
          "uv_size": [
            64,
            64
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "math.lerp((v.cr ?? 0.6), 1.0, math.clamp(1.0 - (v.particle_age / v.particle_lifetime) * 1.0, 0.0, 1.0)) * (math.mod(math.floor(v.particle_age * 30.0), 2.0) > 0.5 ? 0.6 : 1.0) * math.clamp((1.0 - (v.particle_age / v.particle_lifetime)) * 1.5, 0.0, 1.0)",
          "math.lerp((v.cg ?? 0.92), 1.0, math.clamp(1.0 - (v.particle_age / v.particle_lifetime) * 1.0, 0.0, 1.0)) * (math.mod(math.floor(v.particle_age * 30.0), 2.0) > 0.5 ? 0.6 : 1.0) * math.clamp((1.0 - (v.particle_age / v.particle_lifetime)) * 1.5, 0.0, 1.0)",
          "math.lerp((v.cb ?? 1.0), 1.0, math.clamp(1.0 - (v.particle_age / v.particle_lifetime) * 1.0, 0.0, 1.0)) * (math.mod(math.floor(v.particle_age * 30.0), 2.0) > 0.5 ? 0.6 : 1.0) * math.clamp((1.0 - (v.particle_age / v.particle_lifetime)) * 1.5, 0.0, 1.0)",
          "(math.mod(math.floor(v.particle_age * 30.0), 2.0) > 0.5 ? 0.6 : 1.0) * math.clamp((1.0 - (v.particle_age / v.particle_lifetime)) * 1.5, 0.0, 1.0)"
        ]
      }
    }
  }
}
