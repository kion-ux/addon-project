{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "astro:suit_jupiter_on",
      "materials": {
        "default": "entity_emissive_alpha_one_sided",
        "fx": "entity_emissive_alpha",
        "enchanted": "entity_alphatest_glint"
      },
      "textures": {
        "default": "textures/entity/astro/suit_jupiter",
        "enchanted": "textures/misc/enchanted_item_glint"
      },
      "geometry": {
        "default": "geometry.astro.suit_jupiter"
      },
      "animations": {
        "idle": "animation.astro.suit.jupiter.idle",
        "thrust": "animation.astro.suit.jupiter.thrust",
        "sprint": "animation.astro.suit.jupiter.sprint",
        "fp_hide": "animation.astro.suit.jupiter.fp_hide",
        "hide_all": "animation.astro.suit.jupiter.hide_all",
        "assemble": "animation.astro.suit.jupiter.assemble",
        "controller": "controller.animation.astro.suit"
      },
      "scripts": {
        "parent_setup": "v.helmet_layer_visible = 0.0; v.chest_layer_visible = 0.0; v.leg_layer_visible = 0.0; v.boot_layer_visible = 0.0;",
        "pre_animation": [
          "v.astro_fp = c.is_first_person ? 1.0 : 0.0;",
          "v.astro_air = (v.astro_air ?? 0.0) + ((q.is_on_ground ? 0.0 : 1.0) - (v.astro_air ?? 0.0)) * math.min(1.0, q.delta_time * 6.0);",
          "v.astro_run = (v.astro_run ?? 0.0) + ((q.is_sprinting ? 1.0 : 0.0) - (v.astro_run ?? 0.0)) * math.min(1.0, q.delta_time * 6.0);",
          "v.astro_t = (v.astro_t ?? 0.0) + q.delta_time;",
          "v.astro_spin = (v.astro_spin ?? 0.0) + q.delta_time * (1.0 + v.astro_air * 1.5 + v.astro_run * 2.0);"
        ],
        "animate": [
          "controller",
          "idle",
          "thrust",
          {
            "sprint": "v.astro_run > 0.01"
          },
          {
            "fp_hide": "v.astro_fp > 0.5"
          },
          {
            "hide_all": "c.item_slot == 'main_hand' || c.item_slot == 'off_hand'"
          }
        ]
      },
      "render_controllers": [
        "controller.render.astro.suit"
      ]
    }
  }
}
