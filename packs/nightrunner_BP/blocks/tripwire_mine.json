{
  "format_version": "1.21.120",
  "minecraft:block": {
    "description": {
      "identifier": "nr:tripwire_mine",
      "menu_category": {
        "category": "items"
      },
      "states": {
        "nr:trap_state": [
          "armed",
          "idle",
          "triggered"
        ]
      },
      "traits": {
        "minecraft:placement_direction": {
          "enabled_states": [
            "minecraft:cardinal_direction"
          ],
          "y_rotation_offset": 180
        }
      }
    },
    "components": {
      "minecraft:geometry": "geometry.nr.b.tripwire_mine",
      "minecraft:material_instances": {
        "*": {
          "texture": "nr_tripwire_mine",
          "render_method": "alpha_test"
        }
      },
      "minecraft:collision_box": false,
      "minecraft:selection_box": {
        "origin": [
          -8,
          0,
          -3
        ],
        "size": [
          16,
          7,
          6
        ]
      },
      "minecraft:light_dampening": 0,
      "minecraft:map_color": "#7a7c7e",
      "minecraft:light_emission": 1,
      "minecraft:destructible_by_mining": {
        "seconds_to_destroy": 0.5
      },
      "minecraft:destructible_by_explosion": {
        "explosion_resistance": 3.0
      },
      "minecraft:tick": {
        "interval_range": [
          5,
          5
        ],
        "looping": true
      },
      "nr:trap": {
        "key": "tripwire_mine",
        "trigger": "proximity",
        "state": "nr:trap_state",
        "radius": 1.2,
        "who": "zombie",
        "arm_ticks": 40,
        "poll": true
      }
    },
    "permutations": [
      {
        "condition": "q.block_state('nr:trap_state') == 'idle'",
        "components": {
          "minecraft:light_emission": 0
        }
      },
      {
        "condition": "q.block_state('nr:trap_state') == 'triggered'",
        "components": {
          "minecraft:light_emission": 6
        }
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'west'",
        "components": {
          "minecraft:transformation": {
            "rotation": [
              0,
              90,
              0
            ]
          }
        }
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'south'",
        "components": {
          "minecraft:transformation": {
            "rotation": [
              0,
              180,
              0
            ]
          }
        }
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'east'",
        "components": {
          "minecraft:transformation": {
            "rotation": [
              0,
              -90,
              0
            ]
          }
        }
      }
    ]
  }
}
