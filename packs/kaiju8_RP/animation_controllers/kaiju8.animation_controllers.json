          ],
          "transitions": [
            {
              "walk": "query.modified_move_speed > 0.02"
            },
            {
              "death": "query.health <= 0"
            }
          ],
          "blend_transition": 0.2
        },
        "walk": {
          "animations": [
            "look",
            "idle",
            "walk"
          ],
          "transitions": [
            {
              "stand": "query.modified_move_speed <= 0.02"
            },
            {
              "death": "query.health <= 0"
            }
          ],
          "blend_transition": 0.15
        },
        "death": {
          "animations": [
            "death"
          ],
          "blend_transition": 0.2
        }
      }
    },
    "controller.animation.kaiju8.beast.action": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "transitions": [
            {
              "attack": "query.is_delayed_attacking && query.health > 0"
            },
            {
              "hurt": "query.mark_variant == 4"
            }
          ]
        },
        "attack": {
          "animations": [
            "attack"
          ],
          "transitions": [
            {
              "idle": "query.all_animations_finished || query.health <= 0"
            }
          ],
          "blend_transition": 0.06
        },
        "hurt": {
          "animations": [
            "hurt"
          ],
          "transitions": [
            {
              "idle": "query.all_animations_finished || query.mark_variant != 4"
            }
          ],
          "blend_transition": 0.05
        }
      }
    },
    "controller.animation.kaiju8.wings": {
      "initial_state": "ground",
      "states": {
        "ground": {
          "animations": [
            "wings_idle"
          ],
          "transitions": [
            {
              "fly": "!query.is_on_ground"
            }
          ],
          "blend_transition": 0.3
        },
        "fly": {
          "animations": [
            "wings_flap"
          ],
          "transitions": [
            {
              "ground": "query.is_on_ground"
            }
          ],
          "blend_transition": 0.3
        }
      }
    },
    "controller.animation.kaiju8.no8_form": {
      "initial_state": "stand",
      "states": {
        "stand": {
          "animations": [
            "form_idle"
          ],
          "transitions": [
            {
              "swing": "v.swing > 0.0"
            },
            {
              "crouch": "query.is_sneaking"
            },
            {
              "air": "!query.is_on_ground"
            },
            {
              "charge": "query.is_using_item"
            }
          ],
          "blend_transition": 0.18
        },
        "swing": {
          "animations": [
            "form_idle",
            "swing"
          ],
          "transitions": [
            {
              "stand": "query.all_animations_finished"
            }
          ],
          "blend_transition": 0.05
        },
        "crouch": {
          "animations": [
            "form_idle",
            "crouch"
          ],
          "transitions": [
            {
              "swing": "v.swing > 0.0"
            },
            {
              "charge": "query.is_using_item"
            },
            {
              "stand": "!query.is_sneaking"
            }
          ],
          "blend_transition": 0.18
        },
        "air": {
          "animations": [
            "form_idle",
            "air"
          ],
          "transitions": [
            {
              "stand": "query.is_on_ground"
            }
          ],
          "blend_transition": 0.2
        },
        "charge": {
          "animations": [
            "form_idle",
            "charge"
          ],
          "transitions": [
            {
              "stand": "!query.is_using_item"
            }
          ],
          "blend_transition": 0.12
        }
      }
    }
  }
}
