        "ready": "animation.kaiju8.ready.kaiju_detector",
        "ctrl": "controller.animation.kaiju8.wield"
      },
      "scripts": {
        "pre_animation": [
          "v.main_hand = c.item_slot == 'main_hand';",
          "v.sw = math.max(v.attack_time ?? 0.0, 0.0);",
          "v.alt = (v.sw > 0.0 && (v.prev_sw ?? 0.0) <= 0.0) ? math.mod((v.alt ?? 2.0) + 1.0, 3.0) : (v.alt ?? 2.0);",
          "v.prev_sw = v.sw;",
          "v.swing = v.sw;",
          "v.tech = q.is_using_item ? 1.0 : 0.0;",
          "v.talt = (v.tech > 0.5 && (v.prev_tech ?? 0.0) <= 0.0) ? (1.0 - (v.talt ?? 1.0)) : (v.talt ?? 1.0);",
          "v.prev_tech = v.tech;"
        ],
        "animate": [
          "ctrl"
        ]
      },
      "render_controllers": [
        "controller.render.item_default"
      ]
    }
