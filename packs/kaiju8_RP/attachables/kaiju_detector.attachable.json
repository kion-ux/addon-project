      },
      "animations": {
        "third": "animation.kaiju8.wield.kaiju_detector",
        "first": "animation.kaiju8.wield.kaiju_detector_fp",
        "swing": "animation.kaiju8.swing.kaiju_detector",
        "swing2": "animation.kaiju8.swing2.kaiju_detector",
        "swing3": "animation.kaiju8.swing3.kaiju_detector",
        "tech": "animation.kaiju8.tech.kaiju_detector",
