      "scripts": {
        "initialize": [
          "v.nr_s = 0.9318;",
          "v.nr_hn = 8;",
          "v.nr_cw = 0.4204;",
          "v.nr_cr = 0.7728;",
          "v.nr_glp = 2.621;",
          "v.nr_glh = 2.621;",
          "v.nr_gl_back = 2.605;",
          "v.nr_gl_front = 2.621;",
          "v.nr_gl_left = 3.672;",
          "v.nr_gl_right = 3.672;",
          "v.nr_gl_crumple = 3.347;",
          "v.nr_gl_crawl = 2.822;",
          "v.nr_gl_half = 2.717;",
          "v.nr_gl_blown = 3.384;",
          "v.nr_gl_down = 2.605;",
          "v.nr_gl_half_prone = 2.621;",
          "v.nr_seed = math.random(0.0, 1.0);",
          "v.nr_ph = 0.0;",
          "v.nr_run = 0.0;",
          "v.nr_mv = 0.0;",
          "v.nr_age = 0.0;"
        ],
        "pre_animation": [
          "v.nr_age = (v.nr_age ?? 0.0) + q.delta_time;",
          "v.nr_dead = q.property('nr:state') == 'dead';",
          "v.nr_bd = v.nr_bd ?? (v.nr_dead && v.nr_age < 0.3);",
          "v.nr_pose = q.property('nr:pose');",
          "v.nr_ab = v.nr_dead ? 0.0 : q.property('nr:ability');",
          "v.nr_abfull = !v.nr_dead && (0.0);",
          "v.nr_down = q.property('nr:state') == 'down';",
          "v.nr_climb = q.property('nr:state') == 'climb';",
          "v.nr_stag = q.property('nr:state') == 'stagger';",
          "v.nr_half = q.property('nr:torso') == 'halved';",
          "v.nr_gutted = q.property('nr:torso') == 'gutted';",
          "v.nr_cut_lr_lo = q.property('nr:leg_r') == 'cut_lower';",
          "v.nr_cut_lr_up = q.property('nr:leg_r') == 'cut_upper';",
          "v.nr_brk_lr = q.property('nr:leg_r') == 'broken';",
          "v.nr_ok_lr = (q.property('nr:leg_r') == 'intact' || q.property('nr:leg_r') == 'wounded');",
          "v.nr_cut_ll_lo = q.property('nr:leg_l') == 'cut_lower';",
          "v.nr_cut_ll_up = q.property('nr:leg_l') == 'cut_upper';",
          "v.nr_brk_ll = q.property('nr:leg_l') == 'broken';",
          "v.nr_ok_ll = (q.property('nr:leg_l') == 'intact' || q.property('nr:leg_l') == 'wounded');",
          "v.nr_cut_ar_lo = q.property('nr:arm_r') == 'cut_lower';",
          "v.nr_cut_ar_up = q.property('nr:arm_r') == 'cut_upper';",
          "v.nr_brk_ar = q.property('nr:arm_r') == 'broken';",
          "v.nr_ok_ar = (q.property('nr:arm_r') == 'intact' || q.property('nr:arm_r') == 'wounded');",
          "v.nr_cut_al_lo = q.property('nr:arm_l') == 'cut_lower';",
          "v.nr_cut_al_up = q.property('nr:arm_l') == 'cut_upper';",
          "v.nr_brk_al = q.property('nr:arm_l') == 'broken';",
          "v.nr_ok_al = (q.property('nr:arm_l') == 'intact' || q.property('nr:arm_l') == 'wounded');",
          "v.nr_crawl = !v.nr_dead && !v.nr_down && (q.property('nr:state') == 'crawl' || v.nr_half || v.nr_cut_lr_lo || v.nr_cut_lr_up || v.nr_cut_ll_lo || v.nr_cut_ll_up || (!v.nr_ok_lr && !v.nr_ok_ll));",
          "v.nr_c1 = v.nr_crawl && !v.nr_half && (v.nr_ok_lr != v.nr_ok_ll);",
          "v.nr_c1l = v.nr_ok_ll;",
          "v.nr_gimp = !v.nr_crawl && (v.nr_brk_lr || v.nr_brk_ll);",
          "v.nr_gimpl = v.nr_brk_ll;",
          "v.nr_lowstump = v.nr_half || v.nr_cut_lr_lo || v.nr_cut_lr_up || v.nr_cut_ll_lo || v.nr_cut_ll_up;",
          "v.nr_neck = (q.property('nr:head') == 'severed' || q.property('nr:head') == 'crushed');",
          "v.nr_jawless = q.property('nr:head') == 'jawless';",
          "v.nr_cracked = q.property('nr:head') == 'cracked';",
          "v.nr_dry = q.property('nr:burn') >= 3;",
          "v.nr_shock = !v.nr_dead && q.property('nr:shock') > 0;",
          "v.nr_fire = !v.nr_dead && q.is_on_fire;",
          "v.nr_upright = !v.nr_dead && !v.nr_crawl && !v.nr_down && !v.nr_abfull;",
          "v.nr_look = v.nr_upright || v.nr_crawl;",
          "v.nr_guard = q.property('nr:armor') >= 1 && v.nr_ok_al;",
          "v.nr_awr = v.nr_brk_ar ? 0.3 : 1.0;",
          "v.nr_awl = v.nr_brk_al ? 0.3 : 1.0;",
          "v.nr_limp = math.mod(q.property('nr:variant'), 2);",
          "v.nr_reach = q.property('nr:variant') >= 2;",
          "v.nr_tilt = q.property('nr:variant') == 1 ? 7.0 : (q.property('nr:variant') == 3 ? -6.0 : 0.0);",
          "v.nr_run = math.clamp((v.nr_run ?? 0.0) + (q.has_target ? 2.5 : -2.5) * q.delta_time, 0.0, 1.0);",
          "v.nr_mv = math.lerp(v.nr_mv ?? 0.0, math.clamp(q.ground_speed / 0.6, 0.0, 1.0), math.min(1.0, q.delta_time * 8.0));",
          "v.nr_dm = q.modified_distance_moved;",
          "v.nr_dd = math.clamp(v.nr_dm - (v.nr_dm0 ?? v.nr_dm), 0.0, 0.6);",
          "v.nr_dm0 = v.nr_dm;",
          "v.nr_cyc = v.nr_half ? 0.4443 * v.nr_s : (v.nr_c1 ? 0.5227 * v.nr_s : (v.nr_crawl ? math.lerp(0.5227, 0.6818, v.nr_run) * v.nr_s : (v.nr_gimp ? 0.4512 * v.nr_s : math.lerp(v.nr_cw, v.nr_cr, v.nr_run))));",
          "v.nr_ph = math.mod((v.nr_ph ?? 0.0) + v.nr_dd / math.max(0.05, v.nr_cyc), 4.0);"
        ],
        "animate": [
          "ctrl_move",
          "ctrl_alive",
          "ctrl_fx",
          "ctrl_arm_r",
          "ctrl_arm_l",
