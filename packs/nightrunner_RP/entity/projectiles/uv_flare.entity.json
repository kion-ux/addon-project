{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "nr:proj_uv_flare",
      "materials": {
        "default": "entity_emissive_alpha"
      },
      "textures": {
        "default": "textures/nr/proj/uv_flare"
      },
      "geometry": {
        "default": "geometry.nr.proj.uv_flare"
      },
      "particle_effects": {
        "trail": "nr:uv_glow"
      },
      "animations": {
        "fly": "animation.nr.proj.uv_flare",
        "trail": "animation.nr.proj.trail",
        "ctrl_trail": "controller.animation.nr.proj.trail"
      },
      "scripts": {
        "pre_animation": [
          "v.nr_mv = (q.ground_speed + math.abs(q.vertical_speed)) > 0.3;",
          "t.dx = q.movement_direction(0);",
          "t.dy = q.movement_direction(1);",
          "t.dz = q.movement_direction(2);",
          "v.nr_yaw = (v.nr_mv && (t.dx * t.dx + t.dz * t.dz) > 0.0001) ? math.atan2(-t.dx, t.dz) : (v.nr_yaw ?? q.body_y_rotation);",
          "v.nr_pitch = 0.0;",
          "v.nr_spin = v.nr_mv ? math.mod((v.nr_spin ?? 0.0) + q.delta_time * 300, 360.0) : 0.0;",
          "v.nr_trail = 1.0;"
        ],
        "animate": [
          "fly",
          "ctrl_trail"
        ]
      },
      "render_controllers": [
        "controller.render.nr.proj"
      ]
    }
  }
}
