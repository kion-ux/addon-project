        ],
        "animate": [
          {
            "open": "v.nr_open"
          }
        ]
      },
      "render_controllers": [
        "controller.render.nr.prop.overturned_car",
        "controller.render.nr.prop.overturned_car.glass"
      ],
      "spawn_egg": {
        "base_color": "#28466e",
        "overlay_color": "#1e2024"
      }
    }
  }
}
