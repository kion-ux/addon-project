{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "nr:prop_dumpster",
      "materials": {
        "default": "entity_emissive_alpha"
      },
      "textures": {
        "default": "textures/nr/props/dumpster"
      },
      "geometry": {
        "default": "geometry.nr.prop.dumpster"
      },
      "animations": {
        "open": "animation.nr.prop.dumpster.open"
      },
      "scripts": {
        "initialize": [
          "v.nr_open = 0.0;"
        ],
        "pre_animation": [
          "v.nr_open = math.lerp(v.nr_open, q.property('nr:open'), math.clamp(q.delta_time * 3.0, 0.0, 1.0));"
        ],
        "animate": [
          {
            "open": "v.nr_open"
          }
        ]
      },
      "render_controllers": [
        "controller.render.nr.prop.dumpster"
      ],
      "spawn_egg": {
        "base_color": "#2c5034",
        "overlay_color": "#1e2024"
      }
    }
  }
}
