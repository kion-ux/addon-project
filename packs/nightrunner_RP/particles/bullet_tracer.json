{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "nr:bullet_tracer",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/nr/particle/nr_fx"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_once": {},
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_shape_point": {
        "direction": [
          "(v.dx ?? 0)",
          "(v.dy ?? 0)",
          "(v.dz ?? 1)"
        ]
      },
      "minecraft:particle_initial_speed": "90 * math.clamp((v.speed ?? 1), 0.1, 4)",
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 0.15
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "1.6",
          "0.06"
        ],
        "facing_camera_mode": "lookat_direction",
        "direction": {
          "mode": "derive_from_velocity",
          "min_speed_threshold": 0.05
        },
        "uv": {
          "texture_width": 1024,
          "texture_height": 512,
          "uv": [
            64,
            416
          ],
          "uv_size": [
            64,
            8
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          1,
          0.85,
          0.5,
          "math.clamp((1.0 - (v.particle_age / v.particle_lifetime)) * 3, 0.0, 1.0)"
        ]
      }
    }
  }
}
