{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "nr:ember_trail",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/nr/particle/nr_fx"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_once": {},
      "minecraft:emitter_rate_instant": {
        "num_particles": 4
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 0.08,
        "direction": [
          "math.random(-0.5, 0.5)",
          "math.random(0.3, 1)",
          "math.random(-0.5, 0.5)"
        ]
      },
      "minecraft:particle_initial_speed": "0.3 + 0.7 * v.particle_random_2",
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.4 + 0.5 * v.particle_random_3"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          "(v.particle_random_4 - 0.5) * 1.2",
          1.5,
          "(math.mod(v.particle_random_4 * 3.7, 1.0) - 0.5) * 1.2"
        ],
        "linear_drag_coefficient": 1
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.03 + 0.02 * v.particle_random_4",
          "0.03 + 0.02 * v.particle_random_4"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 1024,
          "texture_height": 512,
          "uv": [
            "(224 + math.min(math.floor(v.particle_random_1 * 2), 1) * 8)",
            416
          ],
          "uv_size": [
            8,
            8
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          1,
          "0.75 + 0.25 * math.sin(v.particle_age * 1500 + v.particle_random_1 * 360)",
          0.6,
          "math.clamp((1.0 - (v.particle_age / v.particle_lifetime)) * 2, 0.0, 1.0)"
        ]
      }
    }
  }
}
