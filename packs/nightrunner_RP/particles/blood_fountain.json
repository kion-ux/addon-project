{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "nr:blood_fountain",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/nr/particle/nr_gore"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_once": {
        "active_time": "math.clamp((v.life ?? 0.6), 0.05, 5)"
      },
      "minecraft:emitter_rate_steady": {
        "spawn_rate": "(24 + 46 * math.clamp((v.gore ?? 1), 0, 1)) * math.sqrt(math.clamp((v.size ?? 1), 0.2, 3))",
        "max_particles": 48
      },
      "minecraft:emitter_shape_point": {
        "direction": [
          "(v.dx ?? 0) + math.random(-0.1, 0.1)",
          "(v.dy ?? 1) + math.random(-0.1, 0.1)",
          "(v.dz ?? 0) + math.random(-0.1, 0.1)"
        ]
      },
      "minecraft:particle_initial_speed": "(3.2 + 2.2 * v.particle_random_2) * (0.72 + 0.28 * math.sin(v.emitter_age * 900)) * (0.6 + 0.4 * math.clamp((v.size ?? 1), 0.2, 3))",
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "(v.particle_random_1 < 0.3 ? 0.45 + 0.2 * v.particle_random_3 : 1.0 + 0.6 * v.particle_random_3)"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          -16,
          0
        ],
        "linear_drag_coefficient": 0.45
      },
      "minecraft:particle_motion_collision": {
        "collision_radius": 0.04,
        "expire_on_contact": true,
        "events": [
          {
            "event": "land",
            "min_speed": 2
          }
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(v.particle_random_1 < 0.3 ? ((0.11 + 0.05 * v.particle_random_3) * math.clamp((v.size ?? 1), 0.2, 3)) * 2 : (v.particle_age < 0.16 ? ((0.045 + 0.04 * v.particle_random_3) * math.clamp((v.size ?? 1), 0.2, 3)) * 3.2 : ((0.045 + 0.04 * v.particle_random_3) * math.clamp((v.size ?? 1), 0.2, 3)) * 1.15))",
          "(v.particle_random_1 < 0.3 ? ((0.11 + 0.05 * v.particle_random_3) * math.clamp((v.size ?? 1), 0.2, 3)) : ((0.045 + 0.04 * v.particle_random_3) * math.clamp((v.size ?? 1), 0.2, 3)))"
        ],
        "facing_camera_mode": "lookat_direction",
        "direction": {
          "mode": "derive_from_velocity",
          "min_speed_threshold": 0.05
        },
        "uv": {
          "texture_width": 1024,
          "texture_height": 1024,
          "uv": [
            "(v.particle_random_1 < 0.3 ? (768 + math.min(math.floor(v.particle_random_4 * 4), 3) * 64) : (v.particle_age < 0.16 ? (448 + math.min(math.floor(v.particle_random_4 * 4), 3) * 64) : (256 + math.min(math.floor(v.particle_random_4 * 8), 7) * 32)))",
            "(v.particle_random_1 < 0.3 ? 640 : (v.particle_age < 0.16 ? 672 : 640))"
          ],
          "uv_size": [
            "(v.particle_random_1 < 0.3 ? 64 : (v.particle_age < 0.16 ? 64 : 32))",
            "(v.particle_random_1 < 0.3 ? 32 : (v.particle_age < 0.16 ? 16 : 32))"
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          1,
          "1.0 - 0.2 * (v.particle_age / v.particle_lifetime)",
          "1.0 - 0.2 * (v.particle_age / v.particle_lifetime)",
          "math.clamp((1.0 - (v.particle_age / v.particle_lifetime)) * 6, 0.0, 1.0)"
        ]
      },
      "minecraft:particle_appearance_lighting": {}
    },
    "events": {
      "land": {
        "randomize": [
          {
            "weight": 4
          },
          {
            "weight": 2,
            "particle_effect": {
              "effect": "nr:blood_splat_ground",
              "type": "emitter",
              "pre_effect_expression": "v.size = 0.22; v.life = 40; v.drop = 1;"
            }
          },
          {
            "weight": 1,
            "particle_effect": {
              "effect": "nr:blood_splat_ground",
              "type": "emitter",
              "pre_effect_expression": "v.size = 0.35; v.life = 40; v.drop = 1;"
            }
          }
        ]
      }
    }
  }
}
