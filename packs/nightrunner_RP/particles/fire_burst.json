{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "nr:fire_burst",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/nr/particle/nr_fx"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_once": {},
      "minecraft:emitter_rate_instant": {
        "num_particles": "math.clamp(math.round(10 + 6 * math.clamp((v.size ?? 1), 0.2, 4)), 6, 28)"
      },
      "minecraft:emitter_shape_sphere": {
        "radius": "0.3 * math.clamp((v.size ?? 1), 0.2, 4)",
        "direction": "outwards"
      },
      "minecraft:particle_initial_speed": "(1.0 + 1.5 * v.particle_random_2) * math.sqrt(math.clamp((v.size ?? 1), 0.2, 4))",
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.45 + 0.35 * v.particle_random_3"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          2.5,
          0
        ],
        "linear_drag_coefficient": 2
      },
      "minecraft:particle_initial_spin": {
        "rotation": "(v.particle_random_4 - 0.5) * 30",
        "rotation_rate": 0
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.35 + 0.3 * v.particle_random_4) * math.clamp((v.size ?? 1), 0.2, 4) * (0.7 + 0.6 * math.sin((v.particle_age / v.particle_lifetime) * 180))",
          "(0.35 + 0.3 * v.particle_random_4) * math.clamp((v.size ?? 1), 0.2, 4) * (0.7 + 0.6 * math.sin((v.particle_age / v.particle_lifetime) * 180))"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 1024,
          "texture_height": 512,
          "flipbook": {
            "base_UV": [
              "(math.min(math.floor(v.particle_random_1 * 2), 1) < 0.5 ? 0 : 512)",
              "(math.min(math.floor(v.particle_random_1 * 2), 1) < 0.5 ? 256 : 256)"
            ],
            "size_UV": [
              64,
              64
            ],
            "step_UV": [
              64,
              0
            ],
            "frames_per_second": 12,
            "max_frame": 8,
            "stretch_to_lifetime": true,
            "loop": false
          }
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          1,
          1,
          1,
          "math.clamp((1.0 - (v.particle_age / v.particle_lifetime)) * 4, 0.0, 1.0)"
        ]
      }
    }
  }
}
