{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "nr:smoke_dark",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/nr/particle/nr_fx"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_once": {
        "active_time": "math.clamp((v.life ?? 2), 0.2, 10) * 0.5"
      },
      "minecraft:emitter_rate_steady": {
        "spawn_rate": "8 + 6 * math.clamp((v.size ?? 1), 0.2, 4)",
        "max_particles": 32
      },
      "minecraft:emitter_shape_sphere": {
        "radius": "0.3 * math.clamp((v.size ?? 1), 0.2, 4)",
        "direction": [
          "math.random(-0.3, 0.3)",
          1,
          "math.random(-0.3, 0.3)"
        ]
      },
      "minecraft:particle_initial_speed": "0.4 + 0.6 * v.particle_random_2",
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "(1.4 + 1.0 * v.particle_random_3) * math.sqrt(math.clamp(math.clamp((v.life ?? 2), 0.2, 10) / 2.0, 0.5, 2.5))"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          "(v.particle_random_4 - 0.5) * 0.6",
          0.9,
          "(math.mod(v.particle_random_4 * 3.1, 1.0) - 0.5) * 0.6"
        ],
        "linear_drag_coefficient": 1.2
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 360)",
        "rotation_rate": "math.random(-25, 25)"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.4 + 0.3 * v.particle_random_4) * math.clamp((v.size ?? 1), 0.2, 4) * (1.0 + 1.6 * (v.particle_age / v.particle_lifetime))",
          "(0.4 + 0.3 * v.particle_random_4) * math.clamp((v.size ?? 1), 0.2, 4) * (1.0 + 1.6 * (v.particle_age / v.particle_lifetime))"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 1024,
          "texture_height": 512,
          "uv": [
            "(0 + math.min(math.floor(math.mod(v.particle_random_1 * 6.1, 1.0) * 8), 7) * 64)",
            320
          ],
          "uv_size": [
            64,
            64
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "(0.12 + 0.12 * (v.particle_age / v.particle_lifetime))",
          "(0.12 + 0.12 * (v.particle_age / v.particle_lifetime)) * 0.95",
          "(0.12 + 0.12 * (v.particle_age / v.particle_lifetime)) * 0.92",
          "0.8 * math.clamp(math.min((v.particle_age / v.particle_lifetime) * 5, (1.0 - (v.particle_age / v.particle_lifetime)) * 1.2), 0.0, 1.0)"
        ]
      },
      "minecraft:particle_appearance_lighting": {}
    }
  }
}
