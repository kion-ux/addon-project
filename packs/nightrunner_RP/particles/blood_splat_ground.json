{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "nr:blood_splat_ground",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/nr/particle/nr_gore"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_once": {},
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          0,
          "v.particle_random_4 * 0.006",
          0
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.clamp((v.life ?? 40), 0.5, 300)"
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 360)",
        "rotation_rate": 0
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          "-14 * (v.drop ?? 0)",
          0
        ],
        "linear_drag_coefficient": "0.5 * (v.drop ?? 0)"
      },
      "minecraft:particle_motion_collision": {
        "collision_radius": 0.01,
        "enabled": "(v.drop ?? 0) > 0",
        "collision_drag": 40,
        "coefficient_of_restitution": 0
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "math.clamp((v.size ?? 1), 0.05, 6) * (0.85 + 0.3 * v.particle_random_1) * (0.5 + 0.5 * math.clamp(v.particle_age / 0.1, 0.0, 1.0))",
          "math.clamp((v.size ?? 1), 0.05, 6) * (0.85 + 0.3 * v.particle_random_1) * (0.5 + 0.5 * math.clamp(v.particle_age / 0.1, 0.0, 1.0))"
        ],
        "facing_camera_mode": "emitter_transform_xz",
        "uv": {
          "texture_width": 1024,
          "texture_height": 1024,
          "uv": [
            "(v.particle_random_2 < 0.62 ? (0 + math.min(math.floor(v.particle_random_3 * 8), 7) * 128) : (0 + math.min(math.floor(v.particle_random_3 * 8), 7) * 128))",
            "(v.particle_random_2 < 0.62 ? 0 : 128)"
          ],
          "uv_size": [
            128,
            128
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "1.0 - 0.32 * math.clamp(v.particle_age / (math.clamp((v.life ?? 40), 0.5, 300) * 0.5 + 0.01), 0.0, 1.0)",
          "1.0 - 0.4 * math.clamp(v.particle_age / (math.clamp((v.life ?? 40), 0.5, 300) * 0.5 + 0.01), 0.0, 1.0)",
          "1.0 - 0.38 * math.clamp(v.particle_age / (math.clamp((v.life ?? 40), 0.5, 300) * 0.5 + 0.01), 0.0, 1.0)",
          "math.clamp((1.0 - (v.particle_age / v.particle_lifetime)) * 9, 0.0, 1.0)"
        ]
      },
      "minecraft:particle_appearance_lighting": {}
    }
  }
}
