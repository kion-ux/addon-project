{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "nr:char_flakes",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/nr/particle/nr_fx"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_once": {},
      "minecraft:emitter_rate_instant": {
        "num_particles": "math.clamp(math.round(math.clamp((v.count ?? 8), 1, 32)), 1, 32)"
      },
      "minecraft:emitter_shape_sphere": {
        "radius": "0.25 * math.clamp((v.size ?? 1), 0.2, 4)",
        "direction": [
          "math.random(-1, 1)",
          "math.random(0.2, 1)",
          "math.random(-1, 1)"
        ]
      },
      "minecraft:particle_initial_speed": "0.4 + 1.1 * v.particle_random_2",
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "2.0 + 1.5 * v.particle_random_3"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          "(v.particle_random_4 - 0.5) * 0.8",
          -1.4,
          "(math.mod(v.particle_random_4 * 5.1, 1.0) - 0.5) * 0.8"
        ],
        "linear_drag_coefficient": 1.8
      },
      "minecraft:particle_motion_collision": {
        "collision_radius": 0.02,
        "collision_drag": 10,
        "coefficient_of_restitution": 0
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 360)",
        "rotation_rate": "(v.particle_random_1 - 0.5) * 240"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.05 + 0.05 * v.particle_random_4) * math.clamp((v.size ?? 1), 0.2, 4)",
          "(0.05 + 0.05 * v.particle_random_4) * math.clamp((v.size ?? 1), 0.2, 4)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 1024,
          "texture_height": 512,
          "uv": [
            "(384 + math.min(math.floor(math.mod(v.particle_random_2 * 3.7, 1.0) * 8), 7) * 16)",
            384
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          1,
          1,
          1,
          "math.clamp((1.0 - (v.particle_age / v.particle_lifetime)) * 3, 0.0, 1.0)"
        ]
      },
      "minecraft:particle_appearance_lighting": {}
    }
  }
}
