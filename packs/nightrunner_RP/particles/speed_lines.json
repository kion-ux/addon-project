{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "nr:speed_lines",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/nr/particle/nr_fx"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_once": {},
      "minecraft:emitter_rate_instant": {
        "num_particles": 6
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 1.4,
        "direction": [
          "-(v.dx ?? 0)",
          "-(v.dy ?? 0)",
          "-(v.dz ?? 1)"
        ],
        "offset": [
          "(v.dx ?? 0) * 2.2",
          "(v.dy ?? 0) * 2.2",
          "(v.dz ?? 1) * 2.2"
        ],
        "surface_only": true
      },
      "minecraft:particle_initial_speed": "14 + 6 * v.particle_random_2",
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 0.18
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.9 + 0.7 * v.particle_random_3",
          "0.03"
        ],
        "facing_camera_mode": "lookat_direction",
        "direction": {
          "mode": "derive_from_velocity",
          "min_speed_threshold": 0.05
        },
        "uv": {
          "texture_width": 1024,
          "texture_height": 512,
          "uv": [
            0,
            416
          ],
          "uv_size": [
            64,
            8
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          1,
          1,
          1,
          "0.35 * math.clamp(math.min((v.particle_age / v.particle_lifetime) * 5, (1.0 - (v.particle_age / v.particle_lifetime)) * 3), 0.0, 1.0)"
        ]
      }
    }
  }
}
