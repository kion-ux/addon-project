{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "nr:kick_impact",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/nr/particle/nr_fx"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_once": {},
      "minecraft:emitter_rate_instant": {
        "num_particles": 12
      },
      "minecraft:emitter_shape_point": {
        "direction": [
          "(v.dx ?? 0) + math.random(-0.45, 0.45)",
          "(v.dy ?? 0) + math.random(-0.1, 0.5)",
          "(v.dz ?? 1) + math.random(-0.45, 0.45)"
        ]
      },
      "minecraft:particle_initial_speed": "(v.particle_random_1 < 0.12 ? 0 : (v.particle_random_1 < 0.7 ? 2.0 + 2.0 * v.particle_random_2 : 2.5 + 2.5 * v.particle_random_2))",
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "(v.particle_random_1 < 0.12 ? 0.25 : 0.4 + 0.3 * v.particle_random_3)"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          "(v.particle_random_1 < 0.7 ? 0.2 : -14)",
          0
        ],
        "linear_drag_coefficient": "(v.particle_random_1 < 0.12 ? 0 : (v.particle_random_1 < 0.7 ? 4 : 0.6))"
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 360)",
        "rotation_rate": "(v.particle_random_1 < 0.7 ? 0 : math.random(-300, 300))"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(v.particle_random_1 < 0.12 ? 0.2 + 1.0 * math.pow((v.particle_age / v.particle_lifetime), 0.5) : (v.particle_random_1 < 0.7 ? ((0.2 + 0.12 * v.particle_random_3) * (1.0 + 1.3 * (v.particle_age / v.particle_lifetime))) : (0.04 + 0.04 * v.particle_random_3)))",
          "(v.particle_random_1 < 0.12 ? 0.2 + 1.0 * math.pow((v.particle_age / v.particle_lifetime), 0.5) : (v.particle_random_1 < 0.7 ? ((0.2 + 0.12 * v.particle_random_3) * (1.0 + 1.3 * (v.particle_age / v.particle_lifetime))) : (0.04 + 0.04 * v.particle_random_3)))"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 1024,
          "texture_height": 512,
          "uv": [
            "(v.particle_random_1 < 0.12 ? 0 : (v.particle_random_1 < 0.7 ? (0 + math.min(math.floor(v.particle_random_4 * 8), 7) * 64) : (512 + math.min(math.floor(v.particle_random_4 * 8), 7) * 16)))",
            "(v.particle_random_1 < 0.12 ? 128 : (v.particle_random_1 < 0.7 ? 320 : 384))"
          ],
          "uv_size": [
            "(v.particle_random_1 < 0.12 ? 128 : (v.particle_random_1 < 0.7 ? 64 : 16))",
            "(v.particle_random_1 < 0.12 ? 128 : (v.particle_random_1 < 0.7 ? 64 : 16))"
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "(v.particle_random_1 < 0.12 ? 1 : 0.66)",
          "(v.particle_random_1 < 0.12 ? 1 : 0.62)",
          "(v.particle_random_1 < 0.12 ? 1 : 0.56)",
          "(v.particle_random_1 < 0.12 ? 0.6 * (1.0 - (v.particle_age / v.particle_lifetime)) : (v.particle_random_1 < 0.7 ? 0.5 * (1.0 - (v.particle_age / v.particle_lifetime)) : math.clamp((1.0 - (v.particle_age / v.particle_lifetime)) * 4, 0.0, 1.0)))"
        ]
      },
      "minecraft:particle_appearance_lighting": {}
    }
  }
}
