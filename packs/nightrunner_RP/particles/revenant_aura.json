{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "nr:revenant_aura",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/nr/particle/nr_fx"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_once": {},
      "minecraft:emitter_rate_instant": {
        "num_particles": "math.clamp(math.round(10 * math.clamp((v.size ?? 1), 0.3, 3)), 4, 24)"
      },
      "minecraft:emitter_shape_sphere": {
        "radius": "0.6 * math.clamp((v.size ?? 1), 0.3, 3)",
        "direction": [
          "math.random(-0.3, 0.3)",
          1,
          "math.random(-0.3, 0.3)"
        ]
      },
      "minecraft:particle_initial_speed": "0.5 + 0.7 * v.particle_random_2",
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.8 + 0.6 * v.particle_random_3"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          "math.cos(v.particle_age * 540 + v.particle_random_1 * 360) * 2.0",
          0.8,
          "math.sin(v.particle_age * 540 + v.particle_random_1 * 360) * 2.0"
        ],
        "linear_drag_coefficient": 0.8
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.16 + 0.1 * v.particle_random_4",
          "0.035"
        ],
        "facing_camera_mode": "lookat_direction",
        "direction": {
          "mode": "derive_from_velocity",
          "min_speed_threshold": 0.05
        },
        "uv": {
          "texture_width": 1024,
          "texture_height": 512,
          "uv": [
            "(128 + math.min(math.floor(v.particle_random_4 * 2), 1) * 32)",
            416
          ],
          "uv_size": [
            32,
            8
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          0.3,
          1,
          0.85,
          "math.clamp(math.min((v.particle_age / v.particle_lifetime) * 5, (1.0 - (v.particle_age / v.particle_lifetime)) * 2), 0.0, 1.0)"
        ]
      },
      "minecraft:emitter_lifetime_events": {
        "creation_event": [
          "murk"
        ]
      }
    },
    "events": {
      "murk": {
        "particle_effect": {
          "effect": "nr:smoke_dark",
          "type": "emitter",
          "pre_effect_expression": "v.size = 0.6; v.life = 1.4;"
        }
      }
    }
  }
}
