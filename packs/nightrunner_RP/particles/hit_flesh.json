{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "nr:hit_flesh",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/nr/particle/nr_gore"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_once": {},
      "minecraft:emitter_rate_instant": {
        "num_particles": 8
      },
      "minecraft:emitter_shape_point": {
        "direction": [
          "(v.dx ?? 0) + math.random(-0.55, 0.55)",
          "(v.dy ?? 0.3) + math.random(-0.55, 0.55)",
          "(v.dz ?? 0) + math.random(-0.55, 0.55)"
        ]
      },
      "minecraft:particle_initial_speed": "1.5 + 2.5 * v.particle_random_2",
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "(v.particle_random_1 < 0.85 ? 0.5 + 0.3 * v.particle_random_4 : 0.35)"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          "(v.particle_random_1 < 0.85 ? -14 : -1)",
          0
        ],
        "linear_drag_coefficient": "(v.particle_random_1 < 0.85 ? 0.8 : 4)"
      },
      "minecraft:particle_motion_collision": {
        "collision_radius": 0.03,
        "expire_on_contact": true
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(v.particle_random_1 < 0.85 ? (v.particle_age < 0.16 ? (0.035 + 0.035 * v.particle_random_3) * 3.2 : (0.035 + 0.035 * v.particle_random_3) * 1.15) : (0.18 + 0.12 * v.particle_random_3))",
          "(v.particle_random_1 < 0.85 ? (0.035 + 0.035 * v.particle_random_3) : (0.18 + 0.12 * v.particle_random_3))"
        ],
        "facing_camera_mode": "lookat_direction",
        "direction": {
          "mode": "derive_from_velocity",
          "min_speed_threshold": 0.05
        },
        "uv": {
          "texture_width": 1024,
          "texture_height": 1024,
          "uv": [
            "(v.particle_random_1 < 0.85 ? (v.particle_age < 0.16 ? (448 + math.min(math.floor(v.particle_random_4 * 4), 3) * 64) : (256 + math.min(math.floor(v.particle_random_4 * 8), 7) * 32)) : (512 + math.min(math.floor(v.particle_random_4 * 4), 3) * 64))",
            "(v.particle_random_1 < 0.85 ? (v.particle_age < 0.16 ? 672 : 640) : 512)"
          ],
          "uv_size": [
            "(v.particle_random_1 < 0.85 ? (v.particle_age < 0.16 ? 64 : 32) : 64)",
            "(v.particle_random_1 < 0.85 ? (v.particle_age < 0.16 ? 16 : 32) : 64)"
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          1,
          1,
          1,
          "(v.particle_random_1 < 0.85 ? math.clamp((1.0 - (v.particle_age / v.particle_lifetime)) * 5, 0.0, 1.0) : 0.6 * (1.0 - (v.particle_age / v.particle_lifetime)))"
        ]
      },
      "minecraft:particle_appearance_lighting": {}
    }
  }
}
