{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "nr:hit_spark",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/nr/particle/nr_fx"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_once": {},
      "minecraft:emitter_rate_instant": {
        "num_particles": 12
      },
      "minecraft:emitter_shape_point": {
        "direction": [
          "(v.dx ?? 0) + math.random(-0.6, 0.6)",
          "(v.dy ?? 0.3) + math.random(-0.6, 0.6)",
          "(v.dz ?? 0) + math.random(-0.6, 0.6)"
        ]
      },
      "minecraft:particle_initial_speed": "(v.particle_random_1 < 0.1 ? 0 : 4.0 + 5.0 * v.particle_random_2)",
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "(v.particle_random_1 < 0.1 ? 0.07 : 0.18 + 0.22 * v.particle_random_3)"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          -14,
          0
        ],
        "linear_drag_coefficient": 1.5
      },
      "minecraft:particle_motion_collision": {
        "collision_radius": 0.02,
        "collision_drag": 2,
        "coefficient_of_restitution": 0.5
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(v.particle_random_1 < 0.1 ? (0.35) : 0.1 + 0.12 * v.particle_random_3)",
          "(v.particle_random_1 < 0.1 ? (0.35) : 0.03)"
        ],
        "facing_camera_mode": "lookat_direction",
        "direction": {
          "mode": "derive_from_velocity",
          "min_speed_threshold": 0.05
        },
        "uv": {
          "texture_width": 1024,
          "texture_height": 512,
          "uv": [
            "(v.particle_random_1 < 0.1 ? (768 + math.min(math.floor(v.particle_random_4 * 2), 1) * 64) : (128 + math.min(math.floor(v.particle_random_4 * 2), 1) * 32))",
            "(v.particle_random_1 < 0.1 ? 320 : 416)"
          ],
          "uv_size": [
            "(v.particle_random_1 < 0.1 ? 64 : 32)",
            "(v.particle_random_1 < 0.1 ? 64 : 8)"
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          1,
          "1.0 - 0.45 * (v.particle_age / v.particle_lifetime)",
          "0.75 - 0.65 * (v.particle_age / v.particle_lifetime)",
          "math.clamp((1.0 - (v.particle_age / v.particle_lifetime)) * 2.5, 0.0, 1.0)"
        ]
      }
    }
  }
}
