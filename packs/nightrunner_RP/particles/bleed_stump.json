{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "nr:bleed_stump",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/nr/particle/nr_gore"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_expression": {
        "activation_expression": 1,
        "expiration_expression": "v.emitter_age > (((v.entity_scale ?? 0) > 0) ? 45 : 1.5)"
      },
      "minecraft:emitter_rate_steady": {
        "spawn_rate": "2.5 + 2.0 * v.emitter_random_1",
        "max_particles": 10
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          "math.random(-0.04, 0.04)",
          "math.random(-0.03, 0)",
          "math.random(-0.04, 0.04)"
        ],
        "direction": [
          0,
          -1,
          0
        ]
      },
      "minecraft:particle_initial_speed": "0.1 + 0.3 * v.particle_random_2",
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 1.6
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          -15,
          0
        ],
        "linear_drag_coefficient": 0.3
      },
      "minecraft:particle_motion_collision": {
        "collision_radius": 0.02,
        "expire_on_contact": true,
        "events": [
          {
            "event": "land",
            "min_speed": 2
          }
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.025 + 0.02 * v.particle_random_3) * (1.4 + 2.0 * math.clamp(v.particle_age * 3.0, 0.0, 1.0))",
          "(0.025 + 0.02 * v.particle_random_3)"
        ],
        "facing_camera_mode": "lookat_direction",
        "direction": {
          "mode": "derive_from_velocity",
          "min_speed_threshold": 0.05
        },
        "uv": {
          "texture_width": 1024,
          "texture_height": 1024,
          "uv": [
            "(448 + math.min(math.floor(v.particle_random_4 * 4), 3) * 64)",
            672
          ],
          "uv_size": [
            64,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          1,
          1,
          1,
          "math.clamp((1.0 - (v.particle_age / v.particle_lifetime)) * 8, 0.0, 1.0)"
        ]
      },
      "minecraft:particle_appearance_lighting": {}
    },
    "events": {
      "land": {
        "randomize": [
          {
            "weight": 6.4
          },
          {
            "weight": 1,
            "particle_effect": {
              "effect": "nr:blood_splat_ground",
              "type": "emitter",
              "pre_effect_expression": "v.size = 0.12; v.life = 12; v.drop = 1;"
            }
          },
          {
            "weight": 0.6,
            "particle_effect": {
              "effect": "nr:blood_splat_ground",
              "type": "emitter",
              "pre_effect_expression": "v.size = 0.18; v.life = 12; v.drop = 1;"
            }
          }
        ]
      }
    }
  }
}
