      "minecraft:emitter_shape_point": {
        "offset": [
          "math.random(-0.2, 0.2) * math.clamp((v.spread ?? 0.25), 0, 2)",
          "math.random(-0.2, 0.2) * math.clamp((v.spread ?? 0.25), 0, 2)",
          "math.random(-0.2, 0.2) * math.clamp((v.spread ?? 0.25), 0, 2)"
        ],
        "direction": [
          "(v.dx ?? 0) + math.random(-1, 1) * (0.16 + math.clamp((v.spread ?? 0.25), 0, 2))",
          "(v.dy ?? 1) + 0.12 + math.random(-1, 1) * (0.16 + math.clamp((v.spread ?? 0.25), 0, 2))",
          "(v.dz ?? 0) + math.random(-1, 1) * (0.16 + math.clamp((v.spread ?? 0.25), 0, 2))"
        ]
      },
      "minecraft:particle_initial_speed": "(3.0 + 4.5 * v.particle_random_1) * math.clamp((v.speed ?? 1), 0.05, 4)",
