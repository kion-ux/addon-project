        "color": [
          "1.0 - 0.25 * (v.particle_age / v.particle_lifetime)",
          "1.0 - 0.3 * (v.particle_age / v.particle_lifetime)",
          "1.0 - 0.3 * (v.particle_age / v.particle_lifetime)",
          "math.clamp((1.0 - (v.particle_age / v.particle_lifetime)) * 6, 0.0, 1.0)"
