        "expire_on_contact": true,
        "events": [
          {
            "event": "land",
            "min_speed": 2
          }
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(v.particle_age < 0.16 ? ((0.045 + 0.045 * v.particle_random_3) * math.clamp((v.size ?? 1), 0.2, 4)) * 3.2 : ((0.045 + 0.045 * v.particle_random_3) * math.clamp((v.size ?? 1), 0.2, 4)) * 1.15)",
          "((0.045 + 0.045 * v.particle_random_3) * math.clamp((v.size ?? 1), 0.2, 4))"
        ],
        "facing_camera_mode": "lookat_direction",
        "direction": {
          "mode": "derive_from_velocity",
          "min_speed_threshold": 0.05
        },
        "uv": {
          "texture_width": 1024,
          "texture_height": 1024,
          "uv": [
            "(v.particle_age < 0.16 ? (448 + math.min(math.floor(v.particle_random_4 * 4), 3) * 64) : (256 + math.min(math.floor(v.particle_random_4 * 8), 7) * 32))",
            "(v.particle_age < 0.16 ? 672 : 640)"
          ],
          "uv_size": [
            "(v.particle_age < 0.16 ? 64 : 32)",
            "(v.particle_age < 0.16 ? 16 : 32)"
          ]
        }
