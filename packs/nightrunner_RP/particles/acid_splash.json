{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "nr:acid_splash",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/nr/particle/nr_fx"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_once": {
        "active_time": "math.clamp((v.life ?? 2.5), 0.3, 30)"
      },
      "minecraft:emitter_rate_steady": {
        "spawn_rate": "(v.emitter_age < 0.1 ? 120 : 6 + 10 * math.clamp((v.radius ?? 1), 0.2, 4) * math.clamp((v.radius ?? 1), 0.2, 4))",
        "max_particles": "math.clamp(14 + 20 * math.clamp((v.radius ?? 1), 0.2, 4), 14, 72)"
      },
      "minecraft:emitter_shape_disc": {
        "radius": "math.clamp((v.radius ?? 1), 0.2, 4)",
        "plane_normal": "y",
        "direction": [
          0,
          1,
          0
        ],
        "offset": [
          0,
          0.02,
          0
        ]
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "(v.particle_random_1 < 0.3 ? math.max(v.emitter_lifetime - v.emitter_age, 0.3) : 0.4 + 0.5 * v.particle_random_2)"
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 360)",
        "rotation_rate": 0
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(v.particle_random_1 < 0.3 ? (0.5 + 0.4 * v.particle_random_4) * math.sqrt(math.clamp((v.radius ?? 1), 0.2, 4)) : (0.05 + 0.1 * v.particle_random_4) * math.clamp((v.particle_age / v.particle_lifetime) * 1.3, 0.0, 1.0))",
          "(v.particle_random_1 < 0.3 ? (0.5 + 0.4 * v.particle_random_4) * math.sqrt(math.clamp((v.radius ?? 1), 0.2, 4)) : (0.05 + 0.1 * v.particle_random_4) * math.clamp((v.particle_age / v.particle_lifetime) * 1.3, 0.0, 1.0))"
        ],
        "facing_camera_mode": "emitter_transform_xz",
        "uv": {
          "texture_width": 1024,
          "texture_height": 512,
          "uv": [
            "(v.particle_random_1 < 0.3 ? 768 : (640 + math.min(math.floor(v.particle_random_3 * 4), 3) * 16))",
            "(v.particle_random_1 < 0.3 ? 320 : 384)"
          ],
          "uv_size": [
            "(v.particle_random_1 < 0.3 ? 64 : 16)",
            "(v.particle_random_1 < 0.3 ? 64 : 16)"
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "(v.particle_random_1 < 0.3 ? 0.45 : 0.7)",
          1,
          "(v.particle_random_1 < 0.3 ? 0.2 : 0.4)",
          "(v.particle_random_1 < 0.3 ? 0.45 * math.clamp(math.min((v.particle_age / v.particle_lifetime) * 8, (1.0 - (v.particle_age / v.particle_lifetime)) * 4), 0.0, 1.0) : 0.9 * math.clamp((1.0 - (v.particle_age / v.particle_lifetime)) * 1.5, 0.0, 1.0))"
        ]
      }
    }
  }
}
