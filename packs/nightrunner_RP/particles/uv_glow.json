{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "nr:uv_glow",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/nr/particle/nr_fx"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_once": {},
      "minecraft:emitter_rate_instant": {
        "num_particles": "math.clamp(math.round(4 + 3 * math.clamp((v.radius ?? 1), 0.2, 5)), 4, 16)"
      },
      "minecraft:emitter_shape_sphere": {
        "radius": "math.clamp((v.radius ?? 1), 0.2, 5)",
        "direction": "outwards"
      },
      "minecraft:particle_initial_speed": "(v.particle_random_1 < 0.55 ? 0.05 : 0.1 + 0.2 * v.particle_random_2)",
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.6 + 0.6 * v.particle_random_2"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0.1,
          0
        ],
        "linear_drag_coefficient": 1
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(v.particle_random_1 < 0.55 ? ((0.6 + 0.6 * v.particle_random_3) * math.sqrt(math.clamp((v.radius ?? 1), 0.2, 5))) : (0.04 + 0.04 * v.particle_random_3))",
          "(v.particle_random_1 < 0.55 ? ((0.6 + 0.6 * v.particle_random_3) * math.sqrt(math.clamp((v.radius ?? 1), 0.2, 5))) : (0.04 + 0.04 * v.particle_random_3))"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 1024,
          "texture_height": 512,
          "uv": [
            "(v.particle_random_1 < 0.55 ? (768 + math.min(math.floor(v.particle_random_4 * 2), 1) * 64) : (768 + math.min(math.floor(v.particle_random_4 * 4), 3) * 16))",
            "(v.particle_random_1 < 0.55 ? 320 : 384)"
          ],
          "uv_size": [
            "(v.particle_random_1 < 0.55 ? 64 : 16)",
            "(v.particle_random_1 < 0.55 ? 64 : 16)"
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          0.55,
          0.32,
          1,
          "(v.particle_random_1 < 0.55 ? 0.22 * math.clamp(math.min((v.particle_age / v.particle_lifetime) * 3, (1.0 - (v.particle_age / v.particle_lifetime)) * 2), 0.0, 1.0) : 0.8 * math.clamp(math.min((v.particle_age / v.particle_lifetime) * 4, (1.0 - (v.particle_age / v.particle_lifetime)) * 2), 0.0, 1.0))"
        ]
      }
    }
  }
