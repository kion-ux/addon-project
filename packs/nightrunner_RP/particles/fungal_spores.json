{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "nr:fungal_spores",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/nr/particle/nr_fx"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_once": {
        "active_time": 4
      },
      "minecraft:emitter_rate_steady": {
        "spawn_rate": "math.clamp(5 + 6 * math.clamp((v.radius ?? 1.5), 0.2, 5), 5, 30)",
        "max_particles": 48
      },
      "minecraft:emitter_shape_sphere": {
        "radius": "math.clamp((v.radius ?? 1.5), 0.2, 5)",
        "direction": "outwards",
        "offset": [
          0,
          0.5,
          0
        ]
      },
      "minecraft:particle_initial_speed": "0.05 + 0.15 * v.particle_random_2",
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "3.0 + 2.0 * v.particle_random_3"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          "math.sin(v.particle_age * 90 + v.particle_random_1 * 360) * 0.3",
          0.05,
          "math.cos(v.particle_age * 90 + v.particle_random_1 * 360) * 0.3"
        ],
        "linear_drag_coefficient": 0.6
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.04 + 0.04 * v.particle_random_4",
          "0.04 + 0.04 * v.particle_random_4"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 1024,
          "texture_height": 512,
          "uv": [
            "(768 + math.min(math.floor(v.particle_random_4 * 4), 3) * 16)",
            384
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          0.8,
          0.85,
          0.45,
          "math.clamp(math.min((v.particle_age / v.particle_lifetime) * 4, (1.0 - (v.particle_age / v.particle_lifetime)) * 3), 0.0, 1.0)"
        ]
      },
      "minecraft:particle_appearance_lighting": {}
    }
  }
}
