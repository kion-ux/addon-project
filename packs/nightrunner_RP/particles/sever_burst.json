{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "nr:sever_burst",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/nr/particle/nr_gore"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_once": {},
      "minecraft:emitter_rate_instant": {
        "num_particles": "math.clamp(math.round(10 + 26 * math.clamp((v.gore ?? 1), 0, 1)), 0, 40)"
      },
      "minecraft:emitter_shape_sphere": {
        "radius": "0.06 * math.clamp((v.size ?? 1), 0.3, 3)",
        "direction": [
          "(v.dx ?? 0) * 1.6 + math.random(-1, 1)",
          "(v.dy ?? 0.3) * 1.6 + math.random(-0.4, 1.2)",
          "(v.dz ?? 0) * 1.6 + math.random(-1, 1)"
        ]
      },
      "minecraft:particle_initial_speed": "(2.0 + 4.0 * v.particle_random_2) * (0.8 + 0.2 * math.clamp((v.size ?? 1), 0.3, 3))",
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "(v.particle_random_1 < 0.75 ? 0.8 + 0.6 * v.particle_random_4 : (v.particle_random_1 < 0.85 ? 2.5 + 1.5 * v.particle_random_4 : 0.45 + 0.25 * v.particle_random_4))"
      },
      "minecraft:particle_initial_spin": {
        "rotation": "(v.particle_random_1 < 0.75 ? 0 : (v.particle_random_1 < 0.85 ? math.random(0, 360) : 0))",
        "rotation_rate": "(v.particle_random_1 < 0.75 ? 0 : (v.particle_random_1 < 0.85 ? (v.particle_random_3 - 0.5) * 900 : 0))"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          -17,
          0
        ],
        "linear_drag_coefficient": "(v.particle_random_1 < 0.75 ? 0.5 : 0.3)",
        "rotation_drag_coefficient": 1
      },
      "minecraft:particle_motion_collision": {
        "collision_radius": 0.04,
        "collision_drag": 5,
        "coefficient_of_restitution": 0.25,
        "events": [
          {
            "event": "land",
            "min_speed": 2
          }
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(v.particle_random_1 < 0.75 ? (v.particle_age < 0.16 ? ((0.045 + 0.05 * v.particle_random_3) * math.clamp((v.size ?? 1), 0.3, 3)) * 3.2 : ((0.045 + 0.05 * v.particle_random_3) * math.clamp((v.size ?? 1), 0.3, 3)) * 1.15) : (v.particle_random_1 < 0.85 ? ((0.09 + 0.09 * v.particle_random_3) * math.clamp((v.size ?? 1), 0.3, 3)) : ((0.12 + 0.06 * v.particle_random_3) * math.clamp((v.size ?? 1), 0.3, 3)) * 2))",
          "(v.particle_random_1 < 0.75 ? ((0.045 + 0.05 * v.particle_random_3) * math.clamp((v.size ?? 1), 0.3, 3)) : (v.particle_random_1 < 0.85 ? ((0.09 + 0.09 * v.particle_random_3) * math.clamp((v.size ?? 1), 0.3, 3)) : ((0.12 + 0.06 * v.particle_random_3) * math.clamp((v.size ?? 1), 0.3, 3))))"
        ],
        "facing_camera_mode": "lookat_direction",
        "direction": {
          "mode": "derive_from_velocity",
          "min_speed_threshold": 0.05
        },
        "uv": {
          "texture_width": 1024,
          "texture_height": 1024,
          "uv": [
            "(v.particle_random_1 < 0.75 ? (v.particle_age < 0.16 ? (448 + math.min(math.floor(v.particle_random_4 * 4), 3) * 64) : (256 + math.min(math.floor(v.particle_random_4 * 8), 7) * 32)) : (v.particle_random_1 < 0.85 ? (0 + math.min(math.floor(v.particle_random_4 * 8), 7) * 32) : (768 + math.min(math.floor(v.particle_random_4 * 4), 3) * 64)))",
            "(v.particle_random_1 < 0.75 ? (v.particle_age < 0.16 ? 672 : 640) : (v.particle_random_1 < 0.85 ? 640 : 640))"
          ],
          "uv_size": [
            "(v.particle_random_1 < 0.75 ? (v.particle_age < 0.16 ? 64 : 32) : (v.particle_random_1 < 0.85 ? 32 : 64))",
            "(v.particle_random_1 < 0.75 ? (v.particle_age < 0.16 ? 16 : 32) : (v.particle_random_1 < 0.85 ? 32 : 32))"
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          1,
          "1.0 - 0.2 * (v.particle_age / v.particle_lifetime)",
          "1.0 - 0.2 * (v.particle_age / v.particle_lifetime)",
          "math.clamp((1.0 - (v.particle_age / v.particle_lifetime)) * 5, 0.0, 1.0)"
        ]
      },
      "minecraft:particle_appearance_lighting": {}
    },
    "events": {
      "land": {
        "randomize": [
          {
            "weight": 4
          },
          {
            "weight": 3,
            "particle_effect": {
              "effect": "nr:blood_splat_ground",
