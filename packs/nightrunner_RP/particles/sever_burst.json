            }
          },
          {
            "weight": 1.5,
            "particle_effect": {
              "effect": "nr:blood_splat_ground",
              "type": "emitter",
              "pre_effect_expression": "v.size = 0.4; v.life = 45; v.drop = 1;"
            }
          },
          {
            "weight": 0.5,
            "particle_effect": {
              "effect": "nr:blood_splat_ground",
              "type": "emitter",
              "pre_effect_expression": "v.size = 0.6; v.life = 45; v.drop = 1;"
            }
          }
        ]
      }
    }
  }
}
