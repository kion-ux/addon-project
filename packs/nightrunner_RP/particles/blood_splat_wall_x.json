          "math.clamp((v.size ?? 1), 0.05, 5) * (0.9 + 0.25 * math.mod(v.particle_random_2 * 7.1, 1.0))",
          "math.clamp((v.size ?? 1), 0.05, 5) * (0.9 + 0.25 * math.mod(v.particle_random_2 * 7.1, 1.0))"
        ],
        "facing_camera_mode": "emitter_transform_yz",
        "uv": {
          "texture_width": 1024,
          "texture_height": 1024,
          "uv": [
            "(math.min(math.floor(v.particle_random_1 * 4), 3) < 0.5 ? 0 : (math.min(math.floor(v.particle_random_1 * 4), 3) < 1.5 ? 512 : (math.min(math.floor(v.particle_random_1 * 4), 3) < 2.5 ? 0 : 512))) + ((v.particle_age * (0.75 + 0.5 * v.particle_random_3)) < 0.3 ? 0 : ((v.particle_age * (0.75 + 0.5 * v.particle_random_3)) < 0.85 ? 1 : ((v.particle_age * (0.75 + 0.5 * v.particle_random_3)) < 1.7 ? 2 : 3))) * 128",
            "(math.min(math.floor(v.particle_random_1 * 4), 3) < 0.5 ? 256 : (math.min(math.floor(v.particle_random_1 * 4), 3) < 1.5 ? 256 : (math.min(math.floor(v.particle_random_1 * 4), 3) < 2.5 ? 384 : 384)))"
