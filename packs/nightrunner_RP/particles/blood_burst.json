{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "nr:blood_burst",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/nr/particle/nr_gore"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_once": {},
      "minecraft:emitter_rate_instant": {
        "num_particles": "math.clamp(math.round(math.clamp((v.count ?? 14), 0, 500) * (0.35 + 0.65 * math.clamp((v.gore ?? 1), 0, 1))), 1, 56)"
      },
      "minecraft:emitter_shape_sphere": {
        "radius": "0.12 * math.clamp((v.size ?? 1), 0.2, 4)",
        "direction": [
          "math.random(-1, 1)",
          "math.random(-0.25, 1.2)",
          "math.random(-1, 1)"
        ]
      },
      "minecraft:particle_initial_speed": "(2.5 + 5.0 * v.particle_random_2) * math.clamp((v.speed ?? 0.8), 0.05, 4)",
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "(v.particle_random_1 < 0.82 ? 0.8 + 0.7 * v.particle_random_3 : 0.35 + 0.2 * v.particle_random_3)"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          -17,
          0
        ],
        "linear_drag_coefficient": "(v.particle_random_1 < 0.82 ? 0.6 : 1.6)"
      },
      "minecraft:particle_motion_collision": {
        "collision_radius": 0.04,
        "expire_on_contact": true,
        "events": [
          {
            "event": "land",
            "min_speed": 2
          }
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(v.particle_random_1 < 0.82 ? (v.particle_age < 0.16 ? ((0.04 + 0.05 * v.particle_random_3) * math.clamp((v.size ?? 1), 0.2, 4)) * 3.2 : ((0.04 + 0.05 * v.particle_random_3) * math.clamp((v.size ?? 1), 0.2, 4)) * 1.15) : ((0.09 + 0.06 * v.particle_random_3) * math.clamp((v.size ?? 1), 0.2, 4)) * 2)",
          "(v.particle_random_1 < 0.82 ? ((0.04 + 0.05 * v.particle_random_3) * math.clamp((v.size ?? 1), 0.2, 4)) : ((0.09 + 0.06 * v.particle_random_3) * math.clamp((v.size ?? 1), 0.2, 4)))"
        ],
        "facing_camera_mode": "lookat_direction",
        "direction": {
          "mode": "derive_from_velocity",
          "min_speed_threshold": 0.05
        },
        "uv": {
          "texture_width": 1024,
          "texture_height": 1024,
          "uv": [
            "(v.particle_random_1 < 0.82 ? (v.particle_age < 0.16 ? (448 + math.min(math.floor(v.particle_random_4 * 4), 3) * 64) : (256 + math.min(math.floor(v.particle_random_4 * 8), 7) * 32)) : (768 + math.min(math.floor(v.particle_random_4 * 4), 3) * 64))",
            "(v.particle_random_1 < 0.82 ? (v.particle_age < 0.16 ? 672 : 640) : 640)"
          ],
          "uv_size": [
            "(v.particle_random_1 < 0.82 ? (v.particle_age < 0.16 ? 64 : 32) : 64)",
            "(v.particle_random_1 < 0.82 ? (v.particle_age < 0.16 ? 16 : 32) : 32)"
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "1.0 - 0.25 * (v.particle_age / v.particle_lifetime)",
          "1.0 - 0.3 * (v.particle_age / v.particle_lifetime)",
          "1.0 - 0.3 * (v.particle_age / v.particle_lifetime)",
          "math.clamp((1.0 - (v.particle_age / v.particle_lifetime)) * 5, 0.0, 1.0)"
        ]
      },
      "minecraft:particle_appearance_lighting": {}
    },
    "events": {
      "land": {
        "randomize": [
          {
            "weight": 6
          },
          {
            "weight": 3,
            "particle_effect": {
              "effect": "nr:blood_splat_ground",
              "type": "emitter",
              "pre_effect_expression": "v.size = 0.22; v.life = 40; v.drop = 1;"
            }
          },
          {
            "weight": 1.2,
            "particle_effect": {
              "effect": "nr:blood_splat_ground",
              "type": "emitter",
              "pre_effect_expression": "v.size = 0.36; v.life = 40; v.drop = 1;"
            }
          }
        ]
      }
    }
  }
}
