{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "nr:explosion",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/nr/particle/nr_fx"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_once": {},
      "minecraft:emitter_rate_instant": {
        "num_particles": "math.clamp(math.round(30 * math.sqrt(math.clamp((v.size ?? 1), 0.3, 4))) + 12, 16, 64)"
      },
      "minecraft:emitter_shape_sphere": {
        "radius": "0.5 * math.clamp((v.size ?? 1), 0.3, 4)",
        "direction": "outwards"
      },
      "minecraft:particle_initial_speed": "(v.particle_random_1 < 0.32 ? (0.8 + 2.0 * v.particle_random_2) * math.sqrt(math.clamp((v.size ?? 1), 0.3, 4)) : (v.particle_random_1 < 0.75 ? (5.0 + 9.0 * v.particle_random_2) * math.sqrt(math.clamp((v.size ?? 1), 0.3, 4)) : (7.0 + 8.0 * v.particle_random_2) * math.sqrt(math.clamp((v.size ?? 1), 0.3, 4))))",
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "(v.particle_random_1 < 0.32 ? 0.75 + 0.4 * v.particle_random_3 : (v.particle_random_1 < 0.75 ? 1.4 + 1.2 * v.particle_random_3 : 0.35 + 0.4 * v.particle_random_3))"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          "(v.particle_random_1 < 0.32 ? 1.2 : -18)",
          0
        ],
        "linear_drag_coefficient": "(v.particle_random_1 < 0.32 ? 3 : (v.particle_random_1 < 0.75 ? 0.35 : 1.2))"
      },
      "minecraft:particle_motion_collision": {
        "collision_radius": 0.05,
        "collision_drag": 4,
        "coefficient_of_restitution": 0.3
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 360)",
        "rotation_rate": "(v.particle_random_1 < 0.32 ? math.random(-40, 40) : (v.particle_random_1 < 0.75 ? (v.particle_random_3 - 0.5) * 800 : 0))"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(v.particle_random_1 < 0.32 ? (1.1 + 1.0 * v.particle_random_4) * math.clamp((v.size ?? 1), 0.3, 4) * (0.6 + 0.6 * math.sqrt((v.particle_age / v.particle_lifetime))) : (v.particle_random_1 < 0.75 ? ((0.06 + 0.07 * v.particle_random_4) * math.sqrt(math.clamp((v.size ?? 1), 0.3, 4))) : (0.08 + 0.06 * v.particle_random_4)))",
          "(v.particle_random_1 < 0.32 ? (1.1 + 1.0 * v.particle_random_4) * math.clamp((v.size ?? 1), 0.3, 4) * (0.6 + 0.6 * math.sqrt((v.particle_age / v.particle_lifetime))) : (v.particle_random_1 < 0.75 ? ((0.06 + 0.07 * v.particle_random_4) * math.sqrt(math.clamp((v.size ?? 1), 0.3, 4))) : (0.08 + 0.06 * v.particle_random_4)))"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 1024,
          "texture_height": 512,
          "uv": [
            "(v.particle_random_1 < 0.32 ? 0 + math.min(math.floor((v.particle_age / v.particle_lifetime) * 8), 7) * 128 : (v.particle_random_1 < 0.75 ? (512 + math.min(math.floor(math.mod(v.particle_random_3 * 7.7, 1.0) * 8), 7) * 16) : (928 + math.min(math.floor(math.mod(v.particle_random_3 * 5.5, 1.0) * 2), 1) * 16)))",
            "(v.particle_random_1 < 0.32 ? 0 : (v.particle_random_1 < 0.75 ? 384 : 384))"
          ],
          "uv_size": [
            "(v.particle_random_1 < 0.32 ? 128 : (v.particle_random_1 < 0.75 ? 16 : 16))",
            "(v.particle_random_1 < 0.32 ? 128 : (v.particle_random_1 < 0.75 ? 16 : 16))"
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          1,
          "(v.particle_random_1 < 0.75 ? 1 : 0.75)",
          "(v.particle_random_1 < 0.75 ? 1 : 0.4)",
          "math.clamp((1.0 - (v.particle_age / v.particle_lifetime)) * 3, 0.0, 1.0)"
        ]
      }
    }
  }
}
