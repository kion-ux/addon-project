{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "nr:w_scrap_katana",
      "materials": {
        "default": "entity_emissive_alpha",
        "enchanted": "entity_alphatest_glint"
      },
      "textures": {
        "default": "textures/nr/weapons/scrap_katana",
        "enchanted": "textures/misc/enchanted_item_glint"
      },
      "geometry": {
        "default": "geometry.nr.w.scrap_katana"
      },
      "animations": {
        "tp": "animation.nr.w.scrap_katana.tp",
        "fp": "animation.nr.w.scrap_katana.fp",
        "tp_use": "animation.nr.w.scrap_katana.tp_use",
        "fp_use": "animation.nr.w.scrap_katana.fp_use"
      },
      "scripts": {
        "pre_animation": [
          "v.nr_fp = c.is_first_person ? 1.0 : 0.0;",
          "v.nr_use = q.is_using_item ? 1.0 : 0.0;",
          "v.nr_usew = (v.nr_usew ?? 0.0) + (v.nr_use - (v.nr_usew ?? 0.0)) * math.min(1.0, q.delta_time * 10.0);"
        ],
        "animate": [
          {
            "tp": "(1.0 - v.nr_fp) * (1.0 - v.nr_usew)"
          },
          {
            "tp_use": "(1.0 - v.nr_fp) * v.nr_usew"
          },
          {
            "fp": "v.nr_fp * (1.0 - v.nr_usew)"
          },
          {
            "fp_use": "v.nr_fp * v.nr_usew"
          }
        ]
      },
      "render_controllers": [
        "controller.render.item_default"
      ]
    }
  }
}
