{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "aot:debris",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/aot_atlas"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": "v.count ?? 8"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0
      },
      "minecraft:emitter_shape_sphere": {
        "radius": "v.spread ?? 0.3",
        "direction": "outwards",
        "surface_only": false
      },
      "minecraft:particle_initial_speed": "(v.speed ?? 6.0) * (0.4 + v.particle_random_1 * 0.8)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          -18,
          0
        ],
        "linear_drag_coefficient": 0.6
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "(v.life ?? 1.0) * (0.6 + v.particle_random_2 * 0.6)"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(v.size ?? 1.0) * 0.14",
          "(v.size ?? 1.0) * 0.14"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 256,
          "texture_height": 256,
          "uv": [
            224,
            64
          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_initial_spin": {
        "rotation": "v.particle_random_3 * 360",
        "rotation_rate": 200
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "v.cr ?? 0.32",
          "v.cg ?? 0.28",
          "v.cb ?? 0.24",
          "math.clamp((1.0 - (v.particle_age / v.particle_lifetime)) * 1.6, 0.0, 1.0)"
        ]
      },
      "minecraft:particle_appearance_lighting": {}
    }
  }
}
