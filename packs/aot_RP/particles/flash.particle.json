{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "aot:flash",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/aot_atlas"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": "v.count ?? 1"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          0,
          0,
          0
        ],
        "direction": [
          "v.vx ?? 0",
          "v.vy ?? 0",
          "v.vz ?? 0"
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "v.life ?? 0.16"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(v.size ?? 1.0) * (0.6 + (v.particle_age / v.particle_lifetime) * 1.6)",
          "(v.size ?? 1.0) * (0.6 + (v.particle_age / v.particle_lifetime) * 1.6)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 256,
          "texture_height": 256,
          "uv": [
            0,
            64
          ],
          "uv_size": [
            64,
            64
          ]
        }
      },
      "minecraft:particle_initial_spin": {
        "rotation": "v.particle_random_1 * 360",
        "rotation_rate": 0
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "math.lerp(v.cr ?? 1.0, 1.0, math.clamp(1.0 - (v.particle_age / v.particle_lifetime) * 2.5, 0.0, 1.0))",
          "math.lerp(v.cg ?? 0.8, 1.0, math.clamp(1.0 - (v.particle_age / v.particle_lifetime) * 2.5, 0.0, 1.0))",
          "math.lerp(v.cb ?? 0.45, 1.0, math.clamp(1.0 - (v.particle_age / v.particle_lifetime) * 2.5, 0.0, 1.0))",
          "math.clamp((1.0 - (v.particle_age / v.particle_lifetime)) * 1.6, 0.0, 1.0)"
        ]
      }
    }
  }
}
