{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "aot:gas",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/aot_atlas"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": "v.count ?? 3"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0
      },
      "minecraft:emitter_shape_sphere": {
        "radius": "v.spread ?? 0.12",
        "direction": [
          "v.vx ?? 0",
          "v.vy ?? -1",
          "v.vz ?? 0"
        ],
        "surface_only": false
      },
      "minecraft:particle_initial_speed": "(v.speed ?? 4.0) * (0.6 + v.particle_random_1 * 0.6)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0.4,
          0
        ],
        "linear_drag_coefficient": 4.0
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "(v.life ?? 0.55) * (0.6 + v.particle_random_2 * 0.6)"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(v.size ?? 1.0) * (0.25 + (v.particle_age / v.particle_lifetime) * 0.9)",
          "(v.size ?? 1.0) * (0.25 + (v.particle_age / v.particle_lifetime) * 0.9)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 256,
          "texture_height": 256,
          "uv": [
            64,
            128
          ],
          "uv_size": [
            64,
            64
          ]
        }
      },
      "minecraft:particle_initial_spin": {
        "rotation": "v.particle_random_3 * 360",
        "rotation_rate": 60
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "v.cr ?? 0.96",
          "v.cg ?? 0.97",
          "v.cb ?? 0.98",
          "0.7 * math.clamp((1.0 - (v.particle_age / v.particle_lifetime)) * 1.6, 0.0, 1.0)"
        ]
      },
      "minecraft:particle_appearance_lighting": {}
    }
  }
}
