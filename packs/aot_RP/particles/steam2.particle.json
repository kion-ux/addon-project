{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "aot:steam2",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/aot_atlas"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": "v.count ?? 4"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0
      },
      "minecraft:emitter_shape_sphere": {
        "radius": "v.spread ?? 0.6",
        "direction": "outwards",
        "surface_only": false
      },
      "minecraft:particle_initial_speed": "(v.speed ?? 0.6) * v.particle_random_1",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          "v.rise ?? 1.4",
          0
        ],
        "linear_drag_coefficient": 1.4
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "(v.life ?? 2.4) * (0.6 + v.particle_random_2 * 0.6)"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(v.size ?? 1.0) * (0.6 + (v.particle_age / v.particle_lifetime) * 1.6)",
          "(v.size ?? 1.0) * (0.6 + (v.particle_age / v.particle_lifetime) * 1.6)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 256,
          "texture_height": 256,
          "uv": [
            0,
            192
          ],
          "uv_size": [
            64,
            64
          ]
        }
      },
      "minecraft:particle_initial_spin": {
        "rotation": "v.particle_random_3 * 360",
        "rotation_rate": "(v.particle_random_4 - 0.5) * 40"
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "v.cr ?? 0.94",
          "v.cg ?? 0.94",
          "v.cb ?? 0.95",
          "0.85 * math.clamp(math.min((v.particle_age / v.particle_lifetime) * 6.0, (1.0 - (v.particle_age / v.particle_lifetime)) * 1.6), 0.0, 1.0)"
        ]
      },
      "minecraft:particle_appearance_lighting": {}
    }
  }
}
